---
import { getAlternatePaths, getLanguage } from '@/lib/site'
import LangText from '@/components/LangText.astro'
import { Image } from 'astro:assets'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'

import todoLuxImg from '@/assets/experience/todo-lux.avif'
import basuralezaImg from '@/assets/experience/basuraleza.avif'
import jauntjarImg from '@/assets/experience/jauntjar.avif'
import duellumImg from '@/assets/projects/duellum.webp'
import tvradarImg from '@/assets/projects/tvradar.webp'
import uploadimgImg from '@/assets/projects/uploadimg.webp'
import wattlyImg from '@/assets/projects/wattly.webp'

const projectImages = {
  jauntjar: jauntjarImg,
  'todo-lux': todoLuxImg,
  basuraleza: basuralezaImg,
  wattly: wattlyImg,
  tvradar: tvradarImg,
  duellum: duellumImg,
  uploadimg: uploadimgImg,
} as const

const projects = PROFESSIONAL_PROFILE.projects
const locale = getLanguage(Astro.url.pathname)
---

<section
  id="proyectos"
  class="surface-panel grid gap-6 rounded-3xl p-5 sm:p-7 lg:p-8"
>
  <div data-animate="reveal" class="flex flex-col gap-2">
    <p class="text-muted-foreground text-xs tracking-[0.3em] uppercase">
      <LangText es="Casos de estudio" en="Case studies" />
    </p>
    <h2 class="text-foreground text-2xl font-semibold tracking-tight sm:text-3xl">
      <LangText es="Proyectos seleccionados" en="Selected projects" />
    </h2>
  </div>

  <div class="grid min-w-0 grid-cols-1 gap-5 sm:grid-cols-2">
    {projects.map((project, index) => (
      <a
        href={
          project.kind === 'case-study'
            ? getAlternatePaths(`/proyectos/${project.id}`)[locale]
            : project.evidenceUrl
        }
        target={project.kind === 'showcase' ? '_blank' : undefined}
        rel="noreferrer noopener"
        data-animate="reveal-up"
        data-animate-delay={`${index * 80}ms`}
        class="bento-card group block min-w-0 rounded-2xl p-4 sm:p-5"
      >
        <div class="media-frame relative mb-4 overflow-hidden rounded-xl">
          <Image
            src={projectImages[project.imageKey as keyof typeof projectImages]}
            alt={
              locale === 'es'
                ? `Captura de la interfaz de ${project.title.es}`
                : `${project.title.en} interface screenshot`
            }
            class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] sm:h-44"
            loading="lazy"
            decoding="async"
            format="avif"
            quality={78}
            widths={[260, 352, 525, 700, 900]}
            width={900}
            height={480}
            sizes="(min-width: 1280px) 420px, (min-width: 1024px) 360px, (min-width: 768px) 320px, calc(100vw - 3rem)"
          />
        </div>

        <div class="flex items-start justify-between gap-3">
          <h3 class="text-foreground group-hover:text-primary text-lg font-semibold tracking-tight transition-colors">
            <LangText es={project.title.es} en={project.title.en} />
          </h3>
          <span
            class="text-primary shrink-0 font-mono text-sm transition-transform duration-200 group-hover:translate-x-1"
            aria-hidden="true"
          >
            {project.kind === 'case-study'
              ? locale === 'es'
                ? 'Leer caso →'
                : 'Read case →'
              : '↗'}
          </span>
        </div>

        {project.kind === 'showcase' ? (
          <>
            <p class="text-primary mt-2 font-mono text-[10px] tracking-widest uppercase">
              <LangText es={project.category.es} en={project.category.en} />
            </p>
            <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
              {locale === 'es' && (
                <span data-lang-content="es">{project.summary.es}</span>
              )}
              {locale === 'en' && (
                <span data-lang-content="en">{project.summary.en}</span>
              )}
            </p>
          </>
        ) : (
          <>
            <p class="text-primary mt-2 font-mono text-[10px] tracking-widest uppercase">
              <LangText es="Caso de estudio" en="Case study" />
            </p>

            <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
              <LangText es={project.summary.es} en={project.summary.en} />
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-[10px] tracking-wider uppercase">
              {project.technologies.map((technology) => (
                <span class="tech-tag rounded-md px-2 py-1">{technology}</span>
              ))}
            </div>
          </>
        )}
      </a>
    ))}
  </div>
</section>
