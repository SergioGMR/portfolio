---
import { getLanguage } from '@/lib/site'
import { AVAILABILITY, ROLE_TITLE } from '@/lib/profile-summary'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'
import BasePage from '@/components/layout/BasePage.astro'
import ThemeToggleLite from '@/components/ThemeToggleLite.astro'
import LanguageToggleLite from '@/components/LanguageToggleLite.astro'
import LanguageService from '@/components/LanguageService.astro'
import LangText from '@/components/LangText.astro'
const locale = getLanguage(Astro.url.pathname)
const home = locale === 'es' ? '/' : '/en'
const homeLink = (hash: string) => `${home}${hash}`
const { person } = PROFESSIONAL_PROFILE

// Page order of the home sections (ids are a kept contract). The observer in
// the script below marks the link whose section is in view.
const sectionLinks = [
  { id: 'proyectos', label: { es: 'Proyectos', en: 'Projects' } },
  { id: 'experiencia', label: { es: 'Experiencia', en: 'Experience' } },
  { id: 'habilidades', label: { es: 'Stack', en: 'Stack' } },
  { id: 'preguntas-frecuentes', label: { es: 'FAQ', en: 'FAQ' } },
  { id: 'contacto', label: { es: 'Contacto', en: 'Contact' } },
] as const

const footerLinks = [
  {
    href: PROFESSIONAL_PROFILE.links.mail,
    label: { es: 'Email', en: 'Email' },
    text: { es: 'Email', en: 'Email' },
    external: false,
  },
  {
    href: 'https://x.com/sergiogmr',
    label: { es: 'X (Twitter)', en: 'X (Twitter)' },
    text: { es: 'X', en: 'X' },
    external: true,
  },
  {
    href: 'https://www.linkedin.com/in/sergiogmr',
    label: { es: 'LinkedIn', en: 'LinkedIn' },
    text: { es: 'LinkedIn', en: 'LinkedIn' },
    external: true,
  },
  {
    href: 'https://github.com/sergiogmr',
    label: { es: 'GitHub', en: 'GitHub' },
    text: { es: 'GitHub', en: 'GitHub' },
    external: true,
  },
  {
    href: 'https://github.com/sergiogmr/portfolio',
    label: { es: 'Código del repositorio en GitHub', en: 'Repo on GitHub' },
    text: { es: 'Código', en: 'Repo' },
    external: true,
  },
] as const
---

<BasePage {...Astro.props}>
  <a
    href="#main-content"
    class="bg-foreground text-background fixed top-2 left-2 z-[100] inline-flex min-h-11 -translate-y-20 items-center px-3 text-sm font-semibold transition focus:translate-y-0"
  >
    <LangText es="Saltar al contenido" en="Skip to content" />
  </a>

  <div data-identity-strip class="border-foreground border-b">
    <div class="text-muted-foreground mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-3 font-mono text-xs tracking-wider uppercase sm:px-6 lg:px-8">
      <p class="text-foreground hidden md:block">
        {person.name} — <LangText es={ROLE_TITLE.es} en={ROLE_TITLE.en} />
      </p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="hidden sm:inline">
          <LangText es={person.location.es} en={person.location.en} />
        </span>
        <span class="hidden sm:inline" aria-hidden="true">
          /
        </span>
        <span>UTC+0/+1</span>
        <span aria-hidden="true">/</span>
        <span class="text-foreground inline-flex items-center gap-2">
          <span
            class="bg-success inline-block h-2 w-2"
            aria-hidden="true"
          ></span>
          <LangText es={AVAILABILITY.es} en={AVAILABILITY.en} />
        </span>
      </p>
    </div>
  </div>

  <header class="bg-background border-border sticky top-0 z-50 border-b">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 px-4 py-1 sm:px-6 lg:flex-nowrap lg:gap-x-8 lg:px-8">
      <a
        href={homeLink('#inicio')}
        class="group order-1 flex min-h-11 min-w-0 flex-col justify-center leading-tight"
      >
        <span class="text-foreground group-hover:text-primary text-sm font-semibold tracking-tight transition-colors">
          SergioGMR
        </span>
        <span class="text-muted-foreground font-mono text-xs tracking-wider uppercase">
          Tech Lead
        </span>
      </a>

      <div class="order-2 ml-auto flex shrink-0 items-center gap-1.5 lg:order-3 lg:ml-0">
        <LanguageToggleLite />
        <ThemeToggleLite />
      </div>

      <nav
        data-section-nav
        class="border-border order-3 flex w-full min-w-0 gap-6 overflow-x-auto border-t lg:order-2 lg:w-auto lg:flex-1 lg:border-t-0"
        aria-label={
          locale === 'es' ? 'Navegación principal' : 'Primary navigation'
        }
      >
        {sectionLinks.map(({ id, label }, index) => (
          <a
            href={homeLink(`#${id}`)}
            data-section-link
            class="text-muted-foreground hover:text-foreground aria-[current=true]:text-foreground aria-[current=true]:border-foreground inline-flex min-h-11 items-center gap-2 focus-visible:outline-ring border-b-2 border-transparent text-sm font-medium whitespace-nowrap transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2"
          >
            <span class="text-primary font-mono text-xs" aria-hidden="true">
              {`0${index + 1}`}
            </span>
            <LangText es={label.es} en={label.en} />
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main
    id="main-content"
    tabindex="-1"
    class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 pt-6 pb-16 sm:gap-12 sm:px-6 sm:pt-10 sm:pb-20 lg:px-8"
  >
    <slot />
  </main>

  <footer class="border-foreground border-t">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-2 sm:px-6 lg:px-8">
      <p class="text-muted-foreground font-mono text-xs tracking-wider uppercase">
        {person.name}
        <span aria-hidden="true">/</span>
        <LangText es={person.location.es} en={person.location.en} />
      </p>
      <ul class="flex flex-wrap items-center">
        {footerLinks.map(({ href, label, text, external }) => (
          <li>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              aria-label={label[locale]}
              class="text-foreground hover:text-primary inline-flex min-h-11 min-w-11 items-center justify-center px-3 text-sm underline underline-offset-4 transition-colors"
            >
              <LangText es={text.es} en={text.en} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </footer>

  <LanguageService />

  <script is:inline>
    ;(function () {
      function reveal() {
        var elements = Array.from(document.querySelectorAll('[data-animate]'))
        var prefersReduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches

        if (prefersReduced || !('IntersectionObserver' in window)) {
          elements.forEach(function (element) {
            element.classList.add('is-visible')
          })
          return
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return
              var element = entry.target
              var delay = element.dataset.animateDelay

              if (delay) element.style.transitionDelay = delay
              element.classList.remove('is-hidden')
              element.classList.add('is-visible')
              observer.unobserve(element)
            })
          },
          { threshold: 0.01, rootMargin: '0px 0px 120px 0px' },
        )

        elements.forEach(function (element) {
          element.classList.add('is-hidden')
          observer.observe(element)
        })
      }

      // Marks the nav link of the section crossing the band 30% to 40% down
      // the viewport. Not motion, so it also runs with reduced motion.
      function trackSection() {
        if (!('IntersectionObserver' in window)) return
        var links = Array.from(document.querySelectorAll('[data-section-link]'))
        var targets = links.map(function (link) {
          var id = (link.getAttribute('href') || '').split('#')[1]
          return id ? document.getElementById(id) : null
        })
        var hero = document.getElementById('inicio')
        if (!hero || targets.indexOf(null) !== -1) return

        var inView = {}
        var current = null
        var spy = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              inView[entry.target.id] = entry.isIntersecting
            })
            if (inView[hero.id]) {
              current = null
            } else {
              for (var index = 0; index < targets.length; index++) {
                if (inView[targets[index].id]) {
                  current = links[index]
                  break
                }
              }
            }
            links.forEach(function (link) {
              if (link === current) link.setAttribute('aria-current', 'true')
              else link.removeAttribute('aria-current')
            })
          },
          { rootMargin: '-30% 0px -60% 0px' },
        )

        spy.observe(hero)
        targets.forEach(function (target) {
          spy.observe(target)
        })
      }

      reveal()
      trackSection()
    })()
  </script>
</BasePage>
