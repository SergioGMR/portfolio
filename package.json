{
  "name": "profile",
  "version": "25.08.12",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "An Astro template for building peofiles.",
  "author": {
    "name": "SergioGMR"
  },
  "license": "MIT",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
