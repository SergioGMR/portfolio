---
import PageShell from '@/components/layout/PageShell.astro'
import HeroSection from '@/components/sections/HeroSection.astro'
import ExperienceSection from '@/components/sections/ExperienceSection.astro'
import SkillsSection from '@/components/sections/SkillsSection.astro'
import ProjectsSection from '@/components/sections/ProjectsSection.astro'
import EducationLanguagesSection from '@/components/sections/EducationLanguagesSection.astro'
import AboutContactSection from '@/components/sections/AboutContactSection.astro'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'
---

<PageShell
  title="Sergio Morales Rodríguez — Tech Lead Full Stack"
  description="Portfolio de Sergio Morales Rodríguez, Tech Lead Full Stack especializado en liderazgo técnico, arquitectura, APIs y entrega de producto."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Sergio Morales Rodríguez',
    jobTitle: 'Tech Lead Full Stack',
    description:
      'Tech Lead Full Stack especializado en liderazgo técnico, arquitectura, APIs y entrega de producto.',
    url: 'https://sgmr.dev/',
    sameAs: [
      PROFESSIONAL_PROFILE.links.github,
      PROFESSIONAL_PROFILE.links.linkedin,
      PROFESSIONAL_PROFILE.links.twitter,
    ],
    knowsAbout: [
      'Laravel',
      'Livewire',
      'FilamentPHP',
      'Laravel Sanctum',
      'CI/CD',
      'Technical leadership',
    ],
    inLanguage: 'es-ES',
  }}
>
  <HeroSection />
  <ExperienceSection />
  <SkillsSection />
  <ProjectsSection />
  <EducationLanguagesSection />
  <AboutContactSection />
</PageShell>
