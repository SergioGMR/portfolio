---
import { getLanguage } from '@/lib/site'
import LangText from '@/components/LangText.astro'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'
const locale = getLanguage(Astro.url.pathname)
const cvUrl = PROFESSIONAL_PROFILE.cvUrls[locale]
---

<section id="inicio" class="pt-4 pb-2 sm:pt-10 lg:pt-16">
  <h1 class="text-foreground">
    {/* prettier-ignore */}
    <span class="text-primary block font-mono text-xs font-medium tracking-wider uppercase">{PROFESSIONAL_PROFILE.person.name}<span class="sr-only">, </span></span>
    <span class="font-display [font-variation-settings:'opsz'_96] mt-4 block max-w-[75rem] text-[clamp(2.75rem,7.2vw,6.75rem)] leading-[0.98] font-bold tracking-[-0.045em] text-balance sm:leading-[0.96]">
      {locale === 'es' ? (
        <span data-lang-content="es">
          Tech Lead Full Stack. Arquitectura y desarrollo web con{' '}
          <span class="text-primary">Laravel.</span>
        </span>
      ) : (
        <span data-lang-content="en">
          Full Stack Tech Lead. Web architecture and development with{' '}
          <span class="text-primary">Laravel.</span>
        </span>
      )}
    </span>
  </h1>

  <div class="mt-8 flex flex-col gap-7 sm:mt-11 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
    <div class="max-w-xl">
      <p class="text-foreground/85 text-base leading-relaxed sm:text-xl">
        <LangText
          es="Soy Sergio Morales Rodríguez, de Las Palmas. Desarrollo aplicaciones web y APIs, con experiencia coordinando equipos de desarrollo y DevOps."
          en="I’m Sergio Morales Rodríguez, based in Las Palmas. I develop web applications and APIs, with experience coordinating development and DevOps teams."
        />
      </p>
    </div>

    <div class="flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-5 sm:gap-y-3">
      <a
        href="#proyectos"
        class="bg-foreground text-background hover:bg-primary hover:text-primary-foreground inline-flex min-h-[3.25rem] items-center justify-center gap-2.5 px-6 text-base font-semibold transition-colors"
      >
        <LangText es="Ver proyectos" en="View projects" />
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14M5 12l7 7 7-7"></path>
        </svg>
      </a>
      <div class="grid grid-cols-2 gap-2.5 sm:flex sm:items-center sm:gap-x-5">
        <a
          href="#contacto"
          class="border-foreground text-foreground hover:bg-foreground hover:text-background inline-flex min-h-12 items-center justify-center border px-6 text-base font-semibold transition-colors sm:min-h-[3.25rem]"
        >
          <LangText es="Contactar" en="Contact" />
        </a>
        <a
          data-lang-content={locale}
          href={cvUrl}
          class="border-foreground text-foreground hover:bg-foreground hover:text-background inline-flex min-h-12 items-center justify-center border px-6 text-base font-semibold transition-colors sm:min-h-11 sm:border-0 sm:px-0 sm:underline sm:underline-offset-[5px] sm:hover:bg-transparent sm:hover:text-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          {locale === 'es' ? 'Ver CV (.pdf)' : 'View CV (.pdf)'}
        </a>
      </div>
    </div>
  </div>

  <dl class="border-foreground mt-12 grid grid-cols-2 border-t sm:mt-16 sm:grid-cols-3">
    <div class="border-border border-b py-4 pr-3 sm:py-5 sm:pr-5">
      <LangText
        as="dt"
        class="text-muted-foreground block font-mono text-xs tracking-wider uppercase"
        es="Especialidad"
        en="Specialty"
      />
      <dd class="font-display mt-1 text-[1.3125rem] font-semibold tracking-[-0.02em] sm:mt-2 sm:text-2xl lg:text-3xl">
        Laravel
      </dd>
    </div>
    <div class="border-border border-b py-4 pr-3 sm:py-5 sm:pr-5">
      <LangText
        as="dt"
        class="text-muted-foreground block font-mono text-xs tracking-wider uppercase"
        es="Enfoque"
        en="Focus"
      />
      <dd class="font-display mt-1 text-[1.3125rem] font-semibold tracking-[-0.02em] sm:mt-2 sm:text-2xl lg:text-3xl">
        APIs &amp; CI/CD
      </dd>
    </div>
    <div class="border-border col-span-2 border-b py-4 sm:col-span-1 sm:py-5">
      <LangText
        as="dt"
        class="text-muted-foreground block font-mono text-xs tracking-wider uppercase"
        es="Ubicación"
        en="Location"
      />
      <dd class="font-display mt-1 text-[1.3125rem] font-semibold tracking-[-0.02em] sm:mt-2 sm:text-2xl lg:text-3xl">
        {PROFESSIONAL_PROFILE.person.location[locale]}
      </dd>
    </div>
  </dl>
</section>
