---
import { getAlternatePaths, getLanguage } from '@/lib/site'
import LangText from '@/components/LangText.astro'
import { Image } from 'astro:assets'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'

import todoLuxImg from '@/assets/experience/todo-lux.avif'
import basuralezaImg from '@/assets/experience/basuraleza.avif'
import jauntjarImg from '@/assets/experience/jauntjar.avif'
import duellumImg from '@/assets/projects/duellum.webp'
import tvradarImg from '@/assets/projects/tvradar.webp'
import uploadimgImg from '@/assets/projects/uploadimg.webp'
import uploadimgDesktopImg from '@/assets/projects/uploadimg-desktop.webp'
import wattlyImg from '@/assets/projects/wattly.webp'

const projectImages = {
  jauntjar: jauntjarImg,
  'todo-lux': todoLuxImg,
  basuraleza: basuralezaImg,
  wattly: wattlyImg,
  tvradar: tvradarImg,
  duellum: duellumImg,
  uploadimg: uploadimgImg,
  'uploadimg-desktop': uploadimgDesktopImg,
} as const

const projects = PROFESSIONAL_PROFILE.projects
const locale = getLanguage(Astro.url.pathname)
---

<section id="proyectos" class="min-w-0">
  <div
    data-animate="reveal"
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pb-4 sm:pb-6"
  >
    <h2 class="font-display text-foreground flex items-baseline gap-3 text-[2.125rem] leading-none font-bold tracking-[-0.04em] sm:gap-[1.125rem] sm:text-[clamp(2.25rem,4vw,3.5rem)]">
      <span
        data-section-number
        class="text-primary font-mono text-[0.8125rem] font-normal tracking-normal sm:text-sm"
        aria-hidden="true"
      >
        01
      </span>
      <LangText es="Proyectos" en="Projects" />
    </h2>
    <p class="text-muted-foreground font-mono text-xs sm:text-[0.8125rem]">
      <LangText
        es={`${projects.length} casos de estudio`}
        en={`${projects.length} case studies`}
      />
    </p>
  </div>

  <ol role="list" class="border-foreground min-w-0 border-y">
    {projects.map((project, index) => (
      <li
        data-animate="reveal-up"
        data-animate-delay={`${index * 80}ms`}
        class="border-border not-first:border-t"
      >
        <a
          href={getAlternatePaths(`/proyectos/${project.id}`)[locale]}
          class="group grid min-h-11 min-w-0 grid-cols-[minmax(0,1fr)_6.5rem] gap-x-3.5 gap-y-2 py-4 sm:grid-cols-[minmax(0,1fr)_11rem] sm:gap-x-8 sm:py-6 lg:grid-cols-[2.5rem_minmax(0,1fr)_minmax(0,1.6fr)_11rem_1.5rem] lg:items-center"
        >
          <div class="col-start-1 row-start-1 flex items-baseline gap-2.5 lg:contents">
            <span
              data-row-number
              class="text-muted-foreground font-mono text-xs lg:text-sm"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display text-foreground group-hover:text-primary text-2xl leading-[1.1] font-semibold tracking-[-0.03em] transition-colors sm:text-[1.75rem] lg:text-[2rem] xl:text-[2.125rem]">
              <LangText es={project.title.es} en={project.title.en} />
            </h3>
          </div>

          <div class="col-start-1 row-start-2 min-w-0 lg:col-start-3 lg:row-start-1">
            <p class="text-foreground/85 line-clamp-3 text-[0.9375rem] leading-[1.45] sm:line-clamp-none sm:text-base sm:leading-normal">
              <LangText es={project.summary.es} en={project.summary.en} />
            </p>
            <p class="text-muted-foreground mt-1.5 font-mono text-xs sm:mt-2 sm:text-[0.8125rem]">
              {project.technologies.slice(0, 4).join('\u00a0· ')}
            </p>
          </div>

          <Image
            src={projectImages[project.imageKey as keyof typeof projectImages]}
            alt=""
            class="border-border col-start-2 row-span-2 row-start-1 aspect-[15/8] w-full self-start border object-cover lg:col-start-4 lg:row-span-1 lg:self-center"
            loading="lazy"
            decoding="async"
            format="avif"
            quality={78}
            widths={[104, 176, 208, 352]}
            width={352}
            height={188}
            sizes="(min-width: 640px) 176px, 104px"
          />

          <span
            data-row-arrow
            class="text-foreground group-hover:text-primary hidden text-[1.375rem] transition-transform duration-200 group-hover:translate-x-1 lg:block lg:text-right"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>
