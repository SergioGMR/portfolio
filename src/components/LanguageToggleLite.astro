---
import { getAlternatePaths, getLanguage } from '@/lib/site'

const locale = getLanguage(Astro.url.pathname)
const paths = getAlternatePaths(Astro.url.pathname)
---

<nav
  aria-label={locale === 'es' ? 'Idioma' : 'Language'}
  class="border-border bg-surface/60 inline-flex items-center gap-1 rounded-full border p-1 text-xs"
>
  {(['es', 'en'] as const).map((language) => (
    <a
      href={paths[language]}
      hreflang={language}
      lang={language}
      data-language-link
      aria-current={language === locale ? 'page' : undefined}
      aria-label={language === 'es' ? 'Español' : 'English'}
      class:list={[
        'hover:bg-muted focus-visible:outline-primary/70 inline-flex min-h-9 min-w-9 items-center justify-center rounded-full px-2 py-1 transition-colors focus-visible:outline focus-visible:outline-2',
        { 'bg-foreground text-background': language === locale },
      ]}
    >
      {language.toUpperCase()}
    </a>
  ))}
</nav>
