---
import { getAlternatePaths, getLanguage } from '@/lib/site'

const locale = getLanguage(Astro.url.pathname)
const paths = getAlternatePaths(Astro.url.pathname)
---

<nav
  aria-label={locale === 'es' ? 'Idioma' : 'Language'}
  class="inline-flex items-center gap-0.5 font-mono text-xs"
>
  {(['es', 'en'] as const).map((language) => (
    <a
      href={paths[language]}
      hreflang={language}
      lang={language}
      data-language-link
      aria-current={language === locale ? 'page' : undefined}
      aria-label={language === 'es' ? 'Español' : 'English'}
      class:list={[
        'border-border hover:bg-muted focus-visible:outline-ring inline-flex min-h-11 min-w-11 items-center justify-center border px-2 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2',
        {
          'bg-foreground text-background border-foreground hover:bg-foreground':
            language === locale,
        },
      ]}
    >
      {language.toUpperCase()}
    </a>
  ))}
</nav>
