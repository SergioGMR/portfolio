{
  "mcpServers": {
    "astro-docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp"
    },
    "lighthouse": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "-y",
        "@danielsogl/lighthouse-mcp@latest"
      ],
      "env": {}
    },
    "stitch": {
      "command": "bunx",
      "args": ["-y", "stitch-mcp"],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "sermapp-06032020",
        "GOOGLE_APPLICATION_CREDENTIALS": "./service-account.json"
      }
    }
  }
}