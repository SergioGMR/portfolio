---
import LangText from '@/components/LangText.astro'
---

<div class="code-panel relative flex min-w-0 flex-col justify-between overflow-hidden rounded-3xl p-4 sm:p-5">
  <!-- Header Bar -->
  <div class="border-border/70 flex min-w-0 items-center justify-between gap-2 rounded-t-xl border-b bg-white/5 px-3 py-2.5 font-mono text-xs text-zinc-400">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
    </div>
    <span class="truncate font-mono text-xs text-zinc-400">
      TechLeadProfile.php
    </span>
    <div class="flex items-center gap-1.5 rounded border border-emerald-800/50 bg-emerald-950/50 px-2 py-0.5 font-mono text-[10px] text-emerald-400">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
      PHP 8.5
    </div>
  </div>

  <!-- Code Snippet Body -->
  <div class="min-w-0 overflow-x-auto font-mono text-[11px] leading-relaxed text-zinc-300">
    <div>
      <span class="text-purple-400">&lt;?php</span>
    </div>
    <div class="text-zinc-500">
      <span class="text-purple-400">namespace</span>{' '}
      <span class="text-blue-300">App\Core\Architecture</span>;
    </div>
    <div class="pt-1">
      <span class="text-amber-400">#[Readonly]</span>
    </div>
    <div>
      <span class="text-purple-400">final class</span>{' '}
      <span class="text-blue-400">TechLeadProfile</span>
    </div>
    <div>&#123;</div>
    <div class="pl-4">
      <span class="text-purple-400">public string</span>{' '}
      <span class="text-cyan-300">$engineer</span> ={' '}
      <span class="text-emerald-300">"Sergio Morales"</span>;
    </div>
    <div class="pl-4">
      <span class="text-purple-400">public string</span>{' '}
      <span class="text-cyan-300">$role</span> ={' '}
      <span class="text-emerald-300">"Tech Lead Full Stack"</span>;
    </div>
    <div class="pl-4">
      <span class="text-purple-400">public array</span>{' '}
      <span class="text-cyan-300">$architecture</span> = [
      <span class="text-emerald-300">"Clean Hexagonal"</span>,{' '}
      <span class="text-emerald-300">"APIs & CI/CD"</span>];
    </div>
    <div class="pl-4">
      <span class="text-purple-400">public array</span>{' '}
      <span class="text-cyan-300">$coreStack</span> = [
    </div>
    <div class="pl-8">
      <span class="text-amber-300">'backend'</span> =&gt; [
      <span class="text-emerald-300">"Laravel"</span>,{' '}
      <span class="text-emerald-300">"Livewire"</span>,{' '}
      <span class="text-emerald-300">"FilamentPHP"</span>],
    </div>
    <div class="pl-8">
      <span class="text-amber-300">'frontend'</span> =&gt; [
      <span class="text-emerald-300">"Astro 7"</span>,{' '}
      <span class="text-emerald-300">"Tailwind v4"</span>,{' '}
      <span class="text-emerald-300">"Vite"</span>],
    </div>
    <div class="pl-8">
      <span class="text-amber-300">'devops'</span> =&gt; [
      <span class="text-emerald-300">"Docker"</span>,{' '}
      <span class="text-emerald-300">"Plesk"</span>,{' '}
      <span class="text-emerald-300">"GitHub Actions"</span>],
    </div>
    <div class="pl-4">];</div>
    <div class="pl-4">
      <span class="text-purple-400">public string</span>{' '}
      <span class="text-cyan-300">$status</span> ={' '}
      <span class="text-emerald-400">"Available"</span>;
    </div>
    <div>&#125;</div>
  </div>

  <!-- Bottom Metric Bar -->
  <div class="border-border/70 mt-4 grid grid-cols-3 rounded-b-xl border-t bg-white/5 p-2.5 text-center font-mono text-[10px]">
    <div>
      <span class="block text-[9px] text-zinc-300">
        <LangText es="PRÁCTICA" en="PRACTICE" />
      </span>
      <span class="font-semibold text-zinc-200">10+ Years</span>
    </div>
    <div class="border-x border-zinc-800/80">
      <span class="block text-[9px] text-zinc-300">
        <LangText es="ARQUITECTURA" en="ARCHITECTURE" />
      </span>
      <span class="font-semibold text-blue-400">Hexagonal</span>
    </div>
    <div>
      <span class="block text-[9px] text-zinc-300">
        <LangText es="UBICACIÓN" en="LOCATION" />
      </span>
      <span class="font-semibold text-zinc-200">Las Palmas</span>
    </div>
  </div>
</div>
