---
import LangText from '@/components/LangText.astro'
import { Image } from 'astro:assets'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'

import todoLuxImg from '@/assets/experience/todo-lux.avif'
import basuralezaImg from '@/assets/experience/basuraleza.avif'
import solutecImg from '@/assets/experience/solutec.avif'

const projectImages = {
  'todo-lux': todoLuxImg,
  basuraleza: basuralezaImg,
  solutec: solutecImg,
} as const

const projects = PROFESSIONAL_PROFILE.projects
---

<section
  class="border-border bg-card text-foreground grid gap-6 rounded-4xl border p-8 shadow-[0_20px_70px_-30px_rgba(0,0,0,0.1)] backdrop-blur sm:p-10 dark:shadow-[0_20px_70px_-30px_rgba(0,0,0,0.6)]"
>
  <div
    data-animate="animate-fade-in"
    class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="text-muted-foreground text-xs tracking-[0.3em] uppercase">
        <LangText es="Casos de estudio" en="Case studies" />
      </p>
      <h2 class="text-foreground text-2xl font-semibold sm:text-3xl">
        <LangText es="Proyectos seleccionados" en="Selected projects" />
      </h2>
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-3">
    {
      projects.map((project, index) => (
        <a
          href={project.evidenceUrl}
          target="_blank"
          rel="noreferrer noopener"
          data-animate="animate-slide-up-fade"
          data-animate-delay={`${index * 120}ms`}
          class="group border-border bg-card text-foreground hover:border-foreground/20 hover:bg-muted block rounded-2xl border p-4 shadow-[0_15px_50px_-30px_rgba(0,0,0,0.08)] backdrop-blur transition hover:-translate-y-1 dark:shadow-[0_15px_50px_-30px_rgba(0,0,0,0.5)]"
        >
          <div class="border-border bg-muted/40 relative mb-4 overflow-hidden rounded-xl border">
            <Image
              src={
                projectImages[project.imageKey as keyof typeof projectImages]
              }
              alt={project.title.es}
              class="h-40 w-full object-cover transition duration-300 group-hover:scale-105"
              loading="lazy"
              decoding="async"
              format="avif"
              quality={80}
              widths={[260, 352, 525, 700, 900]}
              width={900}
              height={480}
              sizes="(min-width: 1280px) 352px, (min-width: 768px) calc((100vw - 8rem) / 3), calc(100vw - 8rem)"
            />
          </div>
          <div data-lang-content="es" class="space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="text-foreground text-lg font-semibold">
                {project.title.es}
              </h3>
              <span class="text-primary text-sm">→</span>
            </div>
            <p class="text-muted-foreground text-xs tracking-[0.18em] uppercase">
              Caso de estudio
            </p>
            <p class="text-foreground/90 text-sm">
              <strong>Problema:</strong> {project.problem.es}
            </p>
            <p class="text-muted-foreground text-sm">
              <strong>Responsabilidad:</strong> {project.responsibility.es}
            </p>
            <p class="text-muted-foreground text-sm">
              <strong>Solución:</strong> {project.solution.es}
            </p>
            <p class="text-foreground/80 text-sm font-medium">
              <strong>Resultado:</strong> {project.result.es}
            </p>
          </div>
          <div data-lang-content="en" class="space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="text-foreground text-lg font-semibold">
                {project.title.en}
              </h3>
              <span class="text-primary text-sm">→</span>
            </div>
            <p class="text-muted-foreground text-xs tracking-[0.18em] uppercase">
              Case study
            </p>
            <p class="text-foreground/90 text-sm">
              <strong>Problem:</strong> {project.problem.en}
            </p>
            <p class="text-muted-foreground text-sm">
              <strong>Responsibility:</strong> {project.responsibility.en}
            </p>
            <p class="text-muted-foreground text-sm">
              <strong>Solution:</strong> {project.solution.en}
            </p>
            <p class="text-foreground/80 text-sm font-medium">
              <strong>Result:</strong> {project.result.en}
            </p>
          </div>
          <div class="text-muted-foreground mt-4 flex flex-wrap gap-2 text-[11px] font-semibold tracking-[0.12em] uppercase">
            {project.technologies.map((technology) => (
              <span class="border-border bg-card/60 rounded-full border px-2 py-1 backdrop-blur">
                {technology}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>
