---
import LangText from '@/components/LangText.astro'
import { createProfileFaq } from '@/lib/profile-faq'
import { getLanguage } from '@/lib/site'

const locale = getLanguage(Astro.url.pathname)
const faq = createProfileFaq(locale)
---

<section id="preguntas-frecuentes" class="min-w-0">
  <div
    data-animate="reveal"
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pb-4 sm:pb-6"
  >
    <h2 class="font-display text-foreground flex items-baseline gap-3 text-[2.125rem] leading-none font-bold tracking-[-0.04em] sm:gap-[1.125rem] sm:text-[clamp(2.25rem,4vw,3.5rem)]">
      <span
        data-section-number
        class="text-primary font-mono text-[0.8125rem] font-normal tracking-normal sm:text-sm"
        aria-hidden="true"
      >
        04
      </span>
      <LangText es="Preguntas frecuentes" en="Frequently asked questions" />
    </h2>
  </div>

  <ul role="list" class="border-foreground min-w-0 border-y">
    {faq.map((item, index) => (
      <li
        data-faq-item
        data-animate="reveal-up"
        data-animate-delay={`${index * 70}ms`}
        class="border-border grid min-w-0 gap-x-8 gap-y-3 py-5 not-first:border-t sm:py-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]"
      >
        <h3
          data-lang-content={locale}
          class="font-display text-foreground text-[1.375rem] leading-[1.15] font-semibold tracking-[-0.025em] sm:text-2xl"
        >
          {item.question}
        </h3>
        <div class="min-w-0">
          <p
            data-lang-content={locale}
            class="text-foreground/85 text-[0.9375rem] leading-[1.5] sm:text-base sm:leading-relaxed"
          >
            {item.answer}
          </p>
          {item.links.length > 0 && (
            <ul class="mt-2 grid gap-x-6 sm:grid-cols-2">
              {item.links.map((link) => (
                <li>
                  <a
                    data-lang-content={locale}
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="text-primary inline-flex min-h-11 items-center text-[0.9375rem] underline underline-offset-4 hover:no-underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
