---
import PageShell from '@/components/layout/PageShell.astro'
import HeroSection from '@/components/sections/HeroSection.astro'
import ProjectsSection from '@/components/sections/ProjectsSection.astro'
import SkillsSection from '@/components/sections/SkillsSection.astro'
import CodeSnippetBento from '@/components/sections/CodeSnippetBento.astro'
import ExperienceSection from '@/components/sections/ExperienceSection.astro'
import EducationLanguagesSection from '@/components/sections/EducationLanguagesSection.astro'
import AboutContactSection from '@/components/sections/AboutContactSection.astro'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'
---

<PageShell
  title="Sergio Morales Rodríguez — Tech Lead Full Stack"
  description="Portfolio de Sergio Morales Rodríguez, Tech Lead Full Stack especializado en liderazgo técnico, arquitectura, APIs y entrega de producto."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Sergio Morales Rodríguez',
    jobTitle: 'Tech Lead Full Stack',
    description:
      'Tech Lead Full Stack especializado en liderazgo técnico, arquitectura, APIs y entrega de producto.',
    url: 'https://sgmr.dev/',
    sameAs: [
      PROFESSIONAL_PROFILE.links.github,
      PROFESSIONAL_PROFILE.links.linkedin,
      PROFESSIONAL_PROFILE.links.twitter,
    ],
    knowsAbout: [
      'Laravel',
      'Livewire',
      'FilamentPHP',
      'Laravel Sanctum',
      'CI/CD',
      'Technical leadership',
    ],
    inLanguage: 'es-ES',
  }}
>
  <HeroSection />

  <div class="grid min-w-0 grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">
    <div class="order-1 min-w-0 lg:col-span-8 lg:col-start-1 lg:row-start-1">
      <ProjectsSection />
    </div>

    <div
      class="order-4 flex min-w-0 flex-col gap-6 lg:order-none lg:col-span-4 lg:col-start-9 lg:row-start-1"
    >
      <CodeSnippetBento />
      <EducationLanguagesSection />
    </div>

    <div class="order-2 min-w-0 lg:col-span-8 lg:col-start-1 lg:row-start-2">
      <ExperienceSection />
    </div>

    <div class="order-3 min-w-0 lg:col-span-4 lg:col-start-9 lg:row-start-2">
      <SkillsSection />
    </div>

    <div class="order-5 min-w-0 lg:col-span-12 lg:col-start-1 lg:row-start-3">
      <AboutContactSection />
    </div>
  </div>
</PageShell>
