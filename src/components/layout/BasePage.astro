---
import '@/styles/globals.css'
import HeadSEO from '@/components/HeadSEO.astro'
import Analytics from '@vercel/analytics/astro'

interface Props {
  title?: string
  description?: string
  schema?: object
  locale?: 'es' | 'en'
  ogImage?: URL | string
  ogType?: string
  noindex?: boolean
  nofollow?: boolean
  alternateLocales?: string[]
  canonicalOverride?: URL | string
}

const {
  title,
  description,
  schema,
  locale = 'es',
  ogImage,
  ogType,
  noindex,
  nofollow,
  alternateLocales,
  canonicalOverride,
} = Astro.props
---

<html lang={locale}>
  <head>
    <script is:inline>
      try {
        const savedLanguage = localStorage.getItem('language')
        if (savedLanguage === 'es' || savedLanguage === 'en') {
          document.documentElement.setAttribute('lang', savedLanguage)
        }
      } catch (_error) {}
    </script>

    <HeadSEO
      title={title}
      description={description}
      schema={schema}
      ogImage={ogImage}
      ogType={ogType}
      locale={locale}
      alternateLocales={alternateLocales}
      noindex={noindex}
      nofollow={nofollow}
      canonicalOverride={canonicalOverride}
    />
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    <slot />
    <Analytics />
  </body>
</html>
