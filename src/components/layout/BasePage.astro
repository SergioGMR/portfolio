---
import type { LanguageMetadata } from '@/lib/language-client'
import '@/styles/globals.css'
import { getLanguage } from '@/lib/site'
import HeadSEO from '@/components/HeadSEO.astro'
import bricolageGrotesque from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url'
import instrumentSans from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url'

interface Props {
  title?: string
  description?: string
  localizedMetadata?: LanguageMetadata
  schema?: Record<string, unknown>
  locale?: 'es' | 'en'
  ogImage?: URL | string
  ogImageType?: string
  ogImageWidth?: number
  ogImageHeight?: number
  ogType?: string
  noindex?: boolean
  nofollow?: boolean
  canonicalOverride?: URL | string
}

const {
  title,
  description,
  localizedMetadata,
  schema,
  locale = getLanguage(Astro.url.pathname),
  ogImage,
  ogImageType,
  ogImageWidth,
  ogImageHeight,
  ogType,
  noindex,
  nofollow,
  canonicalOverride,
} = Astro.props
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={bricolageGrotesque}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={instrumentSans}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      try {
        let savedTheme = 'system'
        try {
          const storedTheme = localStorage.getItem('theme')
          if (
            storedTheme === 'light' ||
            storedTheme === 'dark' ||
            storedTheme === 'system'
          )
            savedTheme = storedTheme
        } catch (_error) {
          // Blocked storage keeps the system default, applied below.
        }
        const systemPrefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches
        const resolved =
          savedTheme === 'system'
            ? systemPrefersDark
              ? 'dark'
              : 'light'
            : savedTheme
        const root = document.documentElement
        root.classList.toggle('dark', resolved === 'dark')
        root.style.colorScheme = resolved
      } catch (_error) {}
    </script>
    <HeadSEO
      title={title}
      description={description}
      localizedMetadata={localizedMetadata}
      schema={schema}
      ogImage={ogImage}
      ogImageType={ogImageType}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogType={ogType}
      locale={locale}
      noindex={noindex}
      nofollow={nofollow}
      canonicalOverride={canonicalOverride}
    />
  </head>
  <body class="bg-background text-foreground min-h-[100dvh] antialiased">
    <slot />
  </body>
</html>
