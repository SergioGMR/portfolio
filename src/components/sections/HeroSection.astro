---
import { getLanguage } from '@/lib/site'
import LangText from '@/components/LangText.astro'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'
const locale = getLanguage(Astro.url.pathname)
---

<section id="inicio" class="relative overflow-hidden py-10 sm:py-16 lg:py-20">
  <div
    class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-96"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-4xl px-1 text-center sm:px-4">
    <div class="flex justify-center">
      <span class="border-primary/30 bg-primary/10 text-primary inline-flex min-h-9 items-center gap-2 rounded-full border px-3 py-1.5 font-mono text-[11px] font-medium sm:px-4 sm:text-xs">
        <span
          class="status-dot relative h-2 w-2 rounded-full"
          aria-hidden="true"
        >
          <span class="bg-primary/40 absolute inset-0 animate-ping rounded-full"></span>
        </span>
        <LangText
          es="Tech Lead & Arquitectura Full Stack"
          en="Tech Lead & Full Stack Architecture"
        />
      </span>
    </div>

    <p class="text-primary mt-6 text-lg font-semibold sm:text-xl">
      {PROFESSIONAL_PROFILE.person.name}
    </p>
    <h1 class="text-foreground mt-3 text-[clamp(2.35rem,10vw,4.5rem)] leading-[1.03] font-semibold tracking-[-0.055em] sm:mt-4">
      <LangText
        es="Tech Lead Full Stack. Arquitectura y desarrollo web con Laravel."
        en="Full Stack Tech Lead. Web architecture and development with Laravel."
      />
    </h1>

    <p class="text-muted-foreground mx-auto mt-5 max-w-2xl text-base leading-relaxed sm:mt-6 sm:text-lg">
      <LangText
        es="Soy Sergio Morales Rodríguez, de Las Palmas. Desarrollo aplicaciones web y APIs, con experiencia coordinando equipos de desarrollo y DevOps."
        en="I’m Sergio Morales Rodríguez, based in Las Palmas. I develop web applications and APIs, with experience coordinating development and DevOps teams."
      />
    </p>

    <p class="text-muted-foreground mt-3 text-sm">
      {PROFESSIONAL_PROFILE.person.location[locale]}
    </p>
    <div class="mt-7 flex flex-col items-stretch justify-center gap-3 sm:mt-4 sm:flex-row sm:flex-wrap sm:items-center">
      <a
        href="#proyectos"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex min-h-11 items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold shadow-[0_14px_30px_-18px_hsl(var(--primary)/0.9)] transition active:scale-[0.98]"
      >
        <LangText es="Ver proyectos" en="View projects" />
        <span class="ml-2" aria-hidden="true">
          ↓
        </span>
      </a>

      <a
        href={PROFESSIONAL_PROFILE.links.mail}
        class="border-border bg-surface/70 text-foreground hover:border-primary/50 hover:bg-surface inline-flex min-h-11 items-center justify-center rounded-full border px-5 py-2.5 text-sm font-medium transition active:scale-[0.98]"
      >
        <LangText es="Contactar con Sergio" en="Contact Sergio" />
      </a>

      {locale === 'es' && (
        <a
          data-lang-content="es"
          href={PROFESSIONAL_PROFILE.cvUrls.es}
          class="border-border bg-surface/70 text-foreground hover:border-primary/50 hover:bg-surface inline-flex min-h-11 items-center justify-center rounded-full border px-5 py-2.5 text-sm font-medium transition active:scale-[0.98]"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver CV (.pdf)
        </a>
      )}
      {locale === 'en' && (
        <a
          data-lang-content="en"
          href={PROFESSIONAL_PROFILE.cvUrls.en}
          class="border-border bg-surface/70 text-foreground hover:border-primary/50 hover:bg-surface inline-flex min-h-11 items-center justify-center rounded-full border px-5 py-2.5 text-sm font-medium transition active:scale-[0.98]"
          target="_blank"
          rel="noopener noreferrer"
        >
          View CV (.pdf)
        </a>
      )}
    </div>

    <div class="mt-6 flex justify-center gap-2 sm:mt-7">
      <a
        href={PROFESSIONAL_PROFILE.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="border-border bg-surface/60 text-muted-foreground hover:border-primary/50 hover:text-foreground inline-flex h-11 w-11 items-center justify-center rounded-full border transition"
        aria-label="GitHub"
      >
        <svg
          class="h-4 w-4 fill-current"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
        </svg>
      </a>
      <a
        href={PROFESSIONAL_PROFILE.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="border-border bg-surface/60 text-muted-foreground hover:border-primary/50 hover:text-foreground inline-flex h-11 w-11 items-center justify-center rounded-full border transition"
        aria-label="LinkedIn"
      >
        <svg
          class="h-4 w-4 fill-current"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
