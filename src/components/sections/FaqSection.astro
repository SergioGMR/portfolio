---
import LangText from '@/components/LangText.astro'
import { createProfileFaq } from '@/lib/profile-faq'
import { getLanguage } from '@/lib/site'

const locale = getLanguage(Astro.url.pathname)
const faq = createProfileFaq(locale)
---

<section
  id="preguntas-frecuentes"
  class="surface-panel grid gap-6 rounded-3xl p-5 sm:p-7 lg:p-8"
>
  <div data-animate="reveal" class="flex flex-col gap-2">
    <p class="text-muted-foreground text-xs tracking-[0.3em] uppercase">
      <LangText es="Perfil" en="Profile" />
    </p>
    <h2 class="text-foreground text-2xl font-semibold tracking-tight sm:text-3xl">
      <LangText es="Preguntas frecuentes" en="Frequently asked questions" />
    </h2>
  </div>

  <div class="grid min-w-0 grid-cols-1 gap-5 lg:grid-cols-2">
    {faq.map((item, index) => (
      <div
        data-faq-item
        data-animate="reveal-up"
        data-animate-delay={`${index * 70}ms`}
        class="bento-card min-w-0 rounded-2xl p-4 sm:p-5"
      >
        <h3
          data-lang-content={locale}
          class="text-foreground text-lg font-semibold tracking-tight"
        >
          {item.question}
        </h3>
        <p
          data-lang-content={locale}
          class="text-muted-foreground mt-3 text-sm leading-relaxed"
        >
          {item.answer}
        </p>
        {item.links.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {item.links.map((link) => (
              <li>
                <a
                  data-lang-content={locale}
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="border-primary/40 bg-primary/10 text-primary hover:bg-primary/20 inline-flex min-h-11 items-center rounded-full border px-4 py-2 text-sm font-semibold transition"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</section>
