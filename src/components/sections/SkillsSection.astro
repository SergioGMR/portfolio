---
import { getAlternatePaths, getLanguage } from '@/lib/site'
import LangText from '@/components/LangText.astro'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'

const capabilities = PROFESSIONAL_PROFILE.capabilities
const locale = getLanguage(Astro.url.pathname)
const caseStudies = PROFESSIONAL_PROFILE.projects.filter(
  (project) => project.kind === 'case-study',
)
const evidenceLinks = new Map([
  ...PROFESSIONAL_PROFILE.experiences.map((experience) => {
    const project = caseStudies.find((project) =>
      project.experienceIds.includes(experience.id),
    )
    return [
      experience.id,
      {
        label:
          project?.title[locale] ??
          (experience.id === 'tecandu'
            ? 'Tecandu'
            : experience.company[locale]),
        href: project
          ? getAlternatePaths(`/proyectos/${project.id}`)[locale]
          : `${locale === 'es' ? '/' : '/en'}#experiencia-${experience.id}`,
      },
    ] as const
  }),
  ...caseStudies.map(
    (project) =>
      [
        project.id,
        {
          label: project.title[locale],
          href: getAlternatePaths(`/proyectos/${project.id}`)[locale],
        },
      ] as const,
  ),
])
---

<section id="habilidades" class="min-w-0">
  <div
    data-animate="reveal"
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pb-4 sm:pb-6"
  >
    <h2 class="font-display text-foreground flex items-baseline gap-3 text-[2.125rem] leading-none font-bold tracking-[-0.04em] sm:gap-[1.125rem] sm:text-[clamp(2.25rem,4vw,3.5rem)]">
      <span
        data-section-number
        class="text-primary font-mono text-[0.8125rem] font-normal tracking-normal sm:text-sm"
        aria-hidden="true"
      >
        03
      </span>
      <LangText es="Stack" en="Stack" />
    </h2>
    <p class="text-muted-foreground max-w-md text-sm sm:text-base">
      <LangText
        es="Capacidades conectadas con mi experiencia y con proyectos concretos."
        en="Capabilities connected to my experience and to specific projects."
      />
    </p>
  </div>

  <ol
    role="list"
    class="border-foreground grid min-w-0 border-y sm:grid-cols-2 lg:grid-cols-4"
  >
    {capabilities.map((capability, index) => (
      <li
        data-animate="reveal-up"
        data-animate-delay={`${index * 70}ms`}
        class="border-border min-w-0 py-5 not-first:border-t sm:py-6 sm:nth-2:border-t-0 sm:odd:pr-6 sm:even:border-l sm:even:pl-6 lg:nth-3:border-t-0 lg:nth-4:border-t-0 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0"
      >
        <article class="flex h-full min-w-0 flex-col">
          <h3 class="font-display text-foreground text-2xl leading-[1.1] font-semibold tracking-[-0.03em]">
            <span data-lang-content={locale}>{capability.label[locale]}</span>
          </h3>
          <p
            data-capability-tech
            class="text-primary mt-3 font-mono text-xs sm:text-[0.8125rem]"
          >
            {capability.technologies.join(' · ')}
          </p>
          <p class="text-foreground/85 mt-3 text-[0.9375rem] leading-[1.45] sm:text-base sm:leading-normal">
            <span data-lang-content={locale}>{capability.summary[locale]}</span>
          </p>
          <div class="mt-auto pt-4">
            <p class="text-muted-foreground font-mono text-xs tracking-wider uppercase">
              <span data-lang-content={locale}>
                {locale === 'es' ? 'Evidencia:' : 'Evidence:'}
              </span>
            </p>
            <ul class="mt-1">
              {capability.evidenceIds.map((id) => {
                const evidence = evidenceLinks.get(id)
                if (!evidence)
                  throw new Error(`Missing capability evidence: ${id}`)
                return (
                  <li>
                    <a
                      href={evidence.href}
                      data-lang-content={locale}
                      class="text-primary inline-flex min-h-11 items-center text-[0.9375rem] underline underline-offset-4 hover:no-underline"
                    >
                      {evidence.label}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>
