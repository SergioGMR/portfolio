    "@tailwindcss/vite": "^4.2.2",
    "astro": "6.0.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^25.5.0",
    "happy-dom": "20.14.5",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2"
