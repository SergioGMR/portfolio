---
const options = [
  { value: 'es', label: 'ES' },
  { value: 'en', label: 'EN' },
]
---

<div class="flex items-center gap-2">
  <label
    class="text-muted-foreground inline-flex items-center gap-1 text-xs sm:hidden"
  >
    <span class="sr-only">Idioma</span>
    <select
      class="focus:ring-primary/50 bg-background rounded-md border px-2 py-1 text-sm focus:ring-2 focus:outline-none"
      aria-label="Seleccionar idioma"
      data-lang-select
    >
      {options.map((opt) => <option value={opt.value}>{opt.label}</option>)}
    </select>
  </label>
  <div
    class="hidden items-center gap-2 rounded-full border px-2 py-1 text-xs sm:inline-flex"
  >
    {
      options.map((opt) => (
        <button
          type="button"
          class="hover:bg-muted focus-visible:outline-primary/70 data-[active=true]:bg-foreground data-[active=true]:text-background data-[active=true]:border-foreground cursor-pointer rounded-full px-3 py-1 transition focus-visible:outline focus-visible:outline-2 data-[active=true]:border data-[active=true]:shadow-sm"
          data-lang-option={opt.value}
          aria-pressed="false"
          aria-label={`Cambiar idioma a ${opt.label}`}
        >
          {opt.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  type Language = 'es' | 'en'

  const LANG_KEY = 'language'

  const isLanguage = (value: unknown): value is Language =>
    value === 'es' || value === 'en'

  const setLang = (lang: Language) => {
    localStorage.setItem(LANG_KEY, lang)
    document.documentElement.setAttribute('lang', lang)
    document
      .querySelectorAll<HTMLElement>('[data-lang-content]')
      .forEach((node) => {
        const target = node.dataset.langContent
        node.classList.toggle('hidden', target !== lang)
      })
    document
      .querySelectorAll<HTMLElement>('[data-i18n-key]')
      .forEach((node) => {
        const key = node.dataset.i18nKey
        const translations = window.portfolioTranslations?.[lang]
        if (!key || !translations) return

        const text = Object.entries(translations).find(
          ([translationKey]) => translationKey === key,
        )?.[1]
        if (typeof text === 'string') node.textContent = text
      })
    window.dispatchEvent(
      new CustomEvent('languageChange', { detail: { language: lang } }),
    )
  }

  const setActive = (lang: Language) => {
    document
      .querySelectorAll<HTMLElement>('[data-lang-option]')
      .forEach((button) => {
        const isActive = button.dataset.langOption === lang
        button.dataset.active = isActive ? 'true' : 'false'
        button.setAttribute('aria-pressed', String(isActive))
      })
  }

  const init = () => {
    const stored = localStorage.getItem(LANG_KEY)
    const saved = isLanguage(stored) ? stored : 'es'
    setLang(saved)
    const select = document.querySelector<HTMLSelectElement>(
      'select[data-lang-select]',
    )
    if (select) {
      select.value = saved
    }
    setActive(saved)
  }

  document.addEventListener('change', (e) => {
    if (
      !(e.target instanceof HTMLSelectElement) ||
      !e.target.hasAttribute('data-lang-select')
    )
      return
    const lang = isLanguage(e.target.value) ? e.target.value : 'es'
    setLang(lang)
    setActive(lang)
  })

  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return

    const button = e.target.closest<HTMLElement>('[data-lang-option]')
    if (!button) return

    const selected = button.dataset.langOption
    const lang = isLanguage(selected) ? selected : 'es'
    setLang(lang)
    setActive(lang)
    const select = document.querySelector<HTMLSelectElement>(
      'select[data-lang-select]',
    )
    if (select) select.value = lang
  })

  init()
</script>
