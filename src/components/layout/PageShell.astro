---
import { Image } from 'astro:assets'

import LanguageToggleLite from '../LanguageToggleLite.astro'
import ThemeToggleLite from '../ThemeToggleLite.astro'
import BasePage from './BasePage.astro'
import faviconImg from '../../../public/favicon.webp'
---

<BasePage {...Astro.props}>
  <a href="#main-content" class="skip-link">
    <span data-lang-content="es">Saltar al contenido</span>
    <span data-lang-content="en">Skip to content</span>
  </a>

  <header class="border-border bg-background/85 supports-[backdrop-filter]:bg-background/70 sticky top-0 z-40 border-b backdrop-blur-xl">
    <div class="text-foreground mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
      <a
        href="/"
        class="flex min-w-0 items-center gap-3"
        aria-label="Sergio Morales Rodríguez"
      >
        <Image
          src={faviconImg}
          alt=""
          class="h-9 w-9 shrink-0 rounded-lg"
          width={60}
          height={60}
        />
        <span class="truncate text-sm font-semibold">
          <span class="sm:hidden">SergioGMR</span>
          <span class="hidden sm:inline">Sergio Morales Rodríguez</span>
        </span>
      </a>

      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <LanguageToggleLite />
        <ThemeToggleLite />
        <a
          href="mailto:sergiogmr+portfolio@icloud.com"
          class="primary-action inline-flex h-9 items-center justify-center rounded-full px-3 text-sm font-semibold transition hover:brightness-110 active:translate-y-px sm:px-4"
        >
          <span data-lang-content="es" class="sr-only sm:not-sr-only">
            Contacto
          </span>
          <span data-lang-content="en" class="sr-only sm:not-sr-only">
            Contact
          </span>
          <span aria-hidden="true" class="sm:hidden">
            @
          </span>
        </a>
      </div>
    </div>
  </header>

  <main
    id="main-content"
    tabindex="-1"
    class="mx-auto flex max-w-6xl flex-col gap-20 px-4 pt-6 pb-20 sm:gap-24 sm:pt-10 lg:gap-28"
  >
    <slot />
  </main>

  <footer class="border-border bg-muted/30 border-t py-9">
    <div class="text-foreground mx-auto flex max-w-6xl flex-col gap-5 px-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-semibold">Sergio Morales Rodríguez</p>
        <p class="text-muted-foreground mt-1 text-sm">Full Stack Developer</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 text-sm">
        <a
          href="mailto:sergiogmr+portfolio@icloud.com"
          class="inverse-action rounded-full px-4 py-2 font-semibold transition hover:opacity-90"
        >
          <span data-lang-content="es">Contacto</span>
          <span data-lang-content="en">Contact</span>
        </a>
        <a
          href="https://x.com/sergiogmr"
          class="text-muted-foreground hover:text-foreground transition"
        >
          X
        </a>
        <a
          href="https://www.linkedin.com/in/sergiogmr"
          class="text-muted-foreground hover:text-foreground transition"
        >
          LinkedIn
        </a>
        <a
          href="https://github.com/sergiogmr"
          class="text-muted-foreground hover:text-foreground transition"
        >
          GitHub
        </a>
        <a
          href="https://github.com/sergiogmr/portfolio"
          class="text-muted-foreground hover:text-foreground transition"
        >
          <span data-lang-content="es">Código</span>
          <span data-lang-content="en">Repo</span>
        </a>
      </div>
    </div>
  </footer>

  <script is:inline>
    ;(function () {
      var prefersReduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return
            var el = entry.target
            var animClasses = (el.dataset.animate || '')
              .split(' ')
              .filter(Boolean)
            var delay = el.dataset.animateDelay

            el.classList.remove('is-hidden')
            el.classList.add('is-visible')

            if (!prefersReduced && animClasses.length) {
              if (delay) el.style.animationDelay = delay
              el.classList.add.apply(el.classList, animClasses)
            }

            observer.unobserve(el)
          })
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      )

      document.querySelectorAll('[data-animate]').forEach(function (el) {
        el.classList.add('is-hidden')
        observer.observe(el)
      })
    })()
  </script>
</BasePage>
