---
import { getLanguage } from '@/lib/site'
interface Props {
  en: string
  es: string
  as?: string
  class?: string
}

const { en, es, as = 'span', class: className = '' } = Astro.props
const locale = getLanguage(Astro.url.pathname)
const Tag = as as keyof HTMLElementTagNameMap
---

<Tag class={className}>
  <span data-lang-content={locale}>{locale === 'es' ? es : en}</span>
</Tag>
