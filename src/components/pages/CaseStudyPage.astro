---
import type { CaseStudyProject } from '@/lib/professional-profile'
import PageShell from '@/components/layout/PageShell.astro'
import LangText from '@/components/LangText.astro'
import { Image, getImage } from 'astro:assets'
import { createCaseStudyMetadata } from '@/lib/page-metadata'
import { getAlternatePaths, getLanguage, SITE_URL } from '@/lib/site'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'
import jauntjarImg from '@/assets/experience/jauntjar.avif'
import todoLuxImg from '@/assets/experience/todo-lux.avif'
import basuralezaImg from '@/assets/experience/basuraleza.avif'
import wattlyImg from '@/assets/projects/wattly.webp'
import tvradarImg from '@/assets/projects/tvradar.webp'
import duellumImg from '@/assets/projects/duellum.webp'
import uploadimgImg from '@/assets/projects/uploadimg.webp'
import uploadimgDesktopImg from '@/assets/projects/uploadimg-desktop.webp'
import todoLuxSocial from '@/assets/social/todo-lux.png'
import basuralezaSocial from '@/assets/social/basuraleza.png'
import wattlySocial from '@/assets/social/wattly.png'
import tvradarSocial from '@/assets/social/tvradar.png'
import duellumSocial from '@/assets/social/duellum.png'
import uploadimgSocial from '@/assets/social/uploadimg.png'
import uploadimgDesktopSocial from '@/assets/social/uploadimg-desktop.png'

interface Props {
  project: CaseStudyProject
}
const { project } = Astro.props
const locale = getLanguage(Astro.url.pathname)
const home = locale === 'es' ? '/' : '/en'
const images = {
  jauntjar: jauntjarImg,
  'todo-lux': todoLuxImg,
  basuraleza: basuralezaImg,
  wattly: wattlyImg,
  tvradar: tvradarImg,
  duellum: duellumImg,
  uploadimg: uploadimgImg,
  'uploadimg-desktop': uploadimgDesktopImg,
}
const image = images[project.imageKey as keyof typeof images]
// Social cards are 1200x630 WebP and use their own sources: every page image
// except JauntJar's is 900x480 and Astro never enlarges a source (see
// `bun run social:build`). JauntJar's page image is already 1200x640. Only the
// og:image card uses these; the on-page image stays as is. The output verifier
// checks the declared size against the emitted file.
const socialSources = {
  jauntjar: jauntjarImg,
  'todo-lux': todoLuxSocial,
  basuraleza: basuralezaSocial,
  wattly: wattlySocial,
  tvradar: tvradarSocial,
  duellum: duellumSocial,
  uploadimg: uploadimgSocial,
  'uploadimg-desktop': uploadimgDesktopSocial,
}
const CARD = { width: 1200, height: 630 }
const card = await getImage({
  src: socialSources[project.imageKey as keyof typeof socialSources],
  format: 'webp',
  ...CARD,
  fit: 'cover',
  quality: 80,
})
const metadata = createCaseStudyMetadata(project)
const projects = PROFESSIONAL_PROFILE.projects
const position = projects.findIndex(({ id }) => id === project.id)
const total = projects.length
const pad = (value: number) => String(value).padStart(2, '0')
// Neighbours follow the order of the home list. The ends have no wrap-around:
// the first case has no previous link and the last has no next link.
const neighbours = [
  { direction: 'prev', project: projects[position - 1] },
  { direction: 'next', project: projects[position + 1] },
] as const
const neighbourLabels = {
  prev: { es: 'Proyecto anterior', en: 'Previous project' },
  next: { es: 'Siguiente proyecto', en: 'Next project' },
} as const
const sections = [
  { es: 'Contexto', en: 'Context', text: project.problem },
  {
    es: 'Mi participación',
    en: 'My contribution',
    text: project.responsibility,
  },
  { es: 'Desarrollo', en: 'Development', text: project.solution },
  { es: 'Entregables', en: 'Deliverables', text: project.result },
]
---

<PageShell
  localizedMetadata={metadata}
  ogImage={new URL(card.src, SITE_URL)}
  ogImageType="image/webp"
  ogImageWidth={CARD.width}
  ogImageHeight={CARD.height}
>
  <article class="min-w-0">
    <nav
      aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
      class="text-muted-foreground flex flex-wrap items-center gap-x-2 font-mono text-xs tracking-wider uppercase"
    >
      <a
        href={`${home}#proyectos`}
        class="text-primary inline-flex min-h-11 items-center underline underline-offset-4 hover:no-underline"
      >
        <LangText es="Proyectos" en="Projects" />
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.title[locale]}</span>
    </nav>

    <div class="mt-2 sm:mt-6">
      <p class="text-primary font-mono text-xs font-medium tracking-wider uppercase">
        <LangText es="Caso de estudio" en="Case study" />
      </p>
      <h1 class="font-display [font-variation-settings:'opsz'_96] text-foreground mt-4 max-w-[75rem] text-[clamp(2.5rem,6.4vw,5.5rem)] leading-[0.98] font-bold tracking-[-0.045em] text-balance">
        {project.title[locale]}
      </h1>
    </div>

    <div class="mt-8 grid min-w-0 gap-x-8 gap-y-4 sm:mt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div class="text-muted-foreground font-mono text-xs leading-relaxed sm:text-[0.8125rem]">
        <p>
          <LangText
            es="Por Sergio Morales Rodríguez"
            en="By Sergio Morales Rodríguez"
          />
        </p>
        <p data-case-position class="mt-1">
          <LangText
            es={`Proyecto ${pad(position + 1)} de ${pad(total)}`}
            en={`Project ${pad(position + 1)} of ${pad(total)}`}
          />
        </p>
      </div>
      <Image
        src={image}
        alt={
          locale === 'es'
            ? `Captura de la interfaz de ${project.title.es}`
            : `${project.title.en} interface screenshot`
        }
        width={1200}
        height={640}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1280px) 800px, (min-width: 1024px) 60vw, calc(100vw - 2rem)"
        format="avif"
        quality={80}
        loading="eager"
        decoding="async"
        class="border-border h-auto w-full min-w-0 border"
      />
    </div>

    <div class="border-foreground mt-10 border-y sm:mt-14">
      {sections.map((section, index) => (
        <section class="border-border grid min-w-0 gap-x-8 gap-y-3 py-6 not-first:border-t sm:py-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
          <h2 class="font-display text-foreground flex items-baseline gap-3 text-[1.625rem] leading-[1.1] font-semibold tracking-[-0.03em] sm:text-[1.75rem]">
            <span
              data-section-number
              class="text-primary font-mono text-xs font-normal tracking-normal sm:text-sm"
              aria-hidden="true"
            >
              {pad(index + 1)}
            </span>
            {section[locale]}
          </h2>
          <p
            data-case-prose
            class="text-foreground/85 max-w-[48ch] text-base leading-relaxed sm:text-[1.0625rem]"
          >
            {section.text[locale]}
          </p>
        </section>
      ))}
      <section class="border-border grid min-w-0 gap-x-8 gap-y-3 border-t py-6 sm:py-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-foreground flex items-baseline gap-3 text-[1.625rem] leading-[1.1] font-semibold tracking-[-0.03em] sm:text-[1.75rem]">
          <span
            data-section-number
            class="text-primary font-mono text-xs font-normal tracking-normal sm:text-sm"
            aria-hidden="true"
          >
            {pad(sections.length + 1)}
          </span>
          <LangText es="Tareas concretas" en="Concrete tasks" />
        </h2>
        <ul
          data-case-prose
          class="text-foreground/85 max-w-[48ch] list-disc space-y-2 pl-5 text-base leading-relaxed sm:text-[1.0625rem]"
        >
          {project.tasks[locale].map((task) => (
            <li>{task}</li>
          ))}
        </ul>
      </section>
      <section class="border-border grid min-w-0 gap-x-8 gap-y-3 border-t py-6 sm:py-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-foreground flex items-baseline gap-3 text-[1.625rem] leading-[1.1] font-semibold tracking-[-0.03em] sm:text-[1.75rem]">
          <span
            data-section-number
            class="text-primary font-mono text-xs font-normal tracking-normal sm:text-sm"
            aria-hidden="true"
          >
            {pad(sections.length + 2)}
          </span>
          <LangText es="Tecnologías" en="Technologies" />
        </h2>
        <ul
          role="list"
          class="text-muted-foreground flex max-w-[48ch] flex-wrap gap-x-6 gap-y-1.5 font-mono text-xs sm:text-[0.8125rem]"
        >
          {project.technologies.map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
      </section>
    </div>

    <div
      data-case-actions
      class="mt-8 flex flex-col gap-2.5 sm:mt-10 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-5 sm:gap-y-3"
    >
      <a
        href={project.evidenceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-foreground text-background hover:bg-primary hover:text-primary-foreground inline-flex min-h-12 items-center justify-center gap-2.5 px-6 text-base font-semibold transition-colors"
      >
        <LangText es="Ver proyecto" en="View project" />
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href={PROFESSIONAL_PROFILE.links.mail}
        class="border-foreground text-foreground hover:bg-foreground hover:text-background inline-flex min-h-12 items-center justify-center border px-6 text-base font-semibold transition-colors"
      >
        <LangText es="Contactar con Sergio" en="Contact Sergio" />
      </a>
      <a
        href={`${home}#proyectos`}
        class="text-primary inline-flex min-h-11 items-center justify-center text-base underline underline-offset-4 hover:no-underline"
      >
        <LangText es="Ver todos los proyectos" en="View all projects" />
      </a>
    </div>

    <nav
      data-case-nav
      aria-label={locale === 'es' ? 'Más proyectos' : 'More projects'}
      class="border-foreground mt-10 grid border-y sm:mt-14 sm:grid-cols-2"
    >
      {neighbours.map(({ direction, project: neighbour }) =>
        neighbour ? (
          <a
            data-case-nav-link={direction}
            href={getAlternatePaths(`/proyectos/${neighbour.id}`)[locale]}
            class:list={[
              'group flex min-h-11 min-w-0 flex-col gap-2 py-5 sm:py-7',
              direction === 'prev' && 'sm:pr-8',
              direction === 'next' && 'sm:col-start-2 sm:pl-8 sm:text-right',
              direction === 'next' &&
                position > 0 &&
                'border-border border-t sm:border-t-0 sm:border-l',
            ]}
          >
            <span class="text-muted-foreground font-mono text-xs tracking-wider uppercase">
              {direction === 'prev' && <span aria-hidden="true">← </span>}
              {neighbourLabels[direction][locale]}:
              {direction === 'next' && <span aria-hidden="true"> →</span>}
            </span>{' '}
            <span class="font-display text-foreground group-hover:text-primary text-2xl leading-[1.1] font-semibold tracking-[-0.03em] transition-colors sm:text-[1.75rem]">
              {neighbour.title[locale]}
            </span>
          </a>
        ) : null,
      )}
    </nav>
  </article>
</PageShell>
