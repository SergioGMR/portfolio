---
import LangText from '@/components/LangText.astro'
import { LINKS } from '@/lib/constants'
---

<section
  id="contacto"
  class="surface-panel text-foreground grid gap-6 rounded-3xl p-5 sm:p-7 lg:grid-cols-[1.1fr_1fr] lg:p-8"
>
  <div data-animate="reveal" class="space-y-4">
    <p class="text-muted-foreground text-xs tracking-[0.3em] uppercase">
      <LangText es="Sobre mí" en="About" />
    </p>
    <h2 class="text-foreground text-2xl font-semibold sm:text-3xl">
      <LangText
        es="Colaboro de forma cercana y pragmática."
        en="I collaborate closely and pragmatically."
      />
    </h2>
    <p class="text-muted-foreground">
      <LangText
        es="Me incorporo a proyectos con contexto, analizo necesidades, coordino trabajo técnico y convierto requisitos en entregables."
        en="I join projects with context, analyse needs, coordinate technical work, and turn requirements into deliverables."
      />
    </p>
    <div
      data-animate="reveal"
      data-animate-delay="150ms"
      class="bento-card text-muted-foreground rounded-2xl p-4 text-sm"
    >
      <LangText
        es="Ubicado en Las Palmas, España. Experiencia freelance en backend, frontend y aplicaciones web y móviles."
        en="Based in Las Palmas, Spain. Freelance experience across backend, frontend, and web and mobile applications."
      />
    </div>
  </div>
  <div
    data-animate="reveal"
    class="bento-card text-foreground rounded-2xl p-5 sm:p-6"
  >
    <p class="text-muted-foreground text-xs tracking-[0.25em] uppercase">
      <LangText es="Contacto" en="Contact" />
    </p>
    <div class="mt-4 space-y-3">
      <div
        data-animate="reveal"
        data-animate-delay="0ms"
        class="border-border bg-muted/30 text-foreground flex min-h-12 flex-col items-start justify-center gap-1 rounded-xl border px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <span class="text-sm">
          <LangText es="Email" en="Email" />
        </span>
        <a class="font-semibold break-all hover:underline" href={LINKS.mail}>
          sergiogmr@icloud.com
        </a>
      </div>
      <div
        data-animate="reveal"
        data-animate-delay="80ms"
        class="border-border bg-muted/30 text-foreground flex min-h-12 items-center justify-between rounded-xl border px-4 py-3"
      >
        <span class="text-sm">LinkedIn</span>
        <a
          class="font-semibold hover:underline"
          href={LINKS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          @sergiogmr
        </a>
      </div>
      <div
        data-animate="reveal"
        data-animate-delay="160ms"
        class="border-border bg-muted/30 text-foreground flex min-h-12 items-center justify-between rounded-xl border px-4 py-3"
      >
        <span class="text-sm">GitHub</span>
        <a
          class="font-semibold hover:underline"
          href={LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          @sergiogmr
        </a>
      </div>
    </div>
  </div>
</section>
