---
import type { Language, LanguageMetadata } from '@/lib/language-client'
import { serializeJsonForScript } from '@/lib/language-client'
import { getAlternatePaths, getLanguage, SITE_URL } from '@/lib/site'

interface Props {
  title?: string
  description?: string
  localizedMetadata?: LanguageMetadata
  ogImage?: URL | string
  noindex?: boolean
  nofollow?: boolean
  locale?: Language
  canonicalOverride?: URL | string
  schema?: Record<string, unknown>
  ogType?: string
}

const {
  title = '',
  description = '',
  localizedMetadata,
  noindex = false,
  nofollow = false,
  locale = getLanguage(Astro.url.pathname),
  schema,
  ogType = 'website',
} = Astro.props
const site = Astro.site?.toString() ?? SITE_URL
const canonicalURL = new URL(
  Astro.props.canonicalOverride ?? Astro.url.pathname,
  site,
)
canonicalURL.pathname = canonicalURL.pathname.replace(/\/+$/, '') || '/'
const alternates = getAlternatePaths(canonicalURL.pathname)
const resolvedOgImage = new URL(Astro.props.ogImage ?? '/og.jpg', site)
const initial = localizedMetadata?.[locale] ?? {
  title,
  description,
  imageAlt: title,
  schema,
}
const initialOgLocale = locale === 'es' ? 'es_ES' : 'en_US'
const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
].join(', ')
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{initial.title}</title>
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
{!noindex && <link rel="canonical" href={canonicalURL} />}
<meta name="description" content={initial.description} />
<meta name="author" content="Sergio Morales Rodríguez" />
<meta property="og:locale" content={initialOgLocale} />
{!noindex && (
  <>
    <link rel="alternate" hreflang="es" href={new URL(alternates.es, site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates.es, site)}
    />
  </>
)}

<link rel="icon" type="image/avif" href="/favicon.avif" />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={initial.title} />
<meta property="og:description" content={initial.description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:secure_url" content={resolvedOgImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={initial.imageAlt} />
<meta property="og:site_name" content="Sergio Morales Rodríguez - Portfolio" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={initial.title} />
<meta property="twitter:description" content={initial.description} />
<meta property="twitter:image" content={resolvedOgImage} />
<meta property="twitter:image:alt" content={initial.imageAlt} />
<meta name="twitter:site" content="@sergiogmr" />
<meta name="twitter:creator" content="@sergiogmr" />

<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content="#ffffff"
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content="#111111"
/>
<meta name="color-scheme" content="light dark" />

{!noindex && initial.schema && (
  <script
    type="application/ld+json"
    set:html={serializeJsonForScript(initial.schema)}
  />
)}
