---
import { getLanguage } from '@/lib/site'

const locale = getLanguage(Astro.url.pathname)
const labels = {
  es: { light: 'Claro', dark: 'Oscuro', system: 'Sistema' },
  en: { light: 'Light', dark: 'Dark', system: 'System' },
}
const options = (['light', 'dark', 'system'] as const).map((value) => ({
  value,
  label: labels[locale][value],
}))
---

<div class="flex items-center">
  <label class="inline-flex items-center text-xs sm:hidden">
    <span class="sr-only">{locale === 'es' ? 'Tema' : 'Theme'}</span>
    <select
      class="border-border bg-background text-foreground focus:ring-primary/50 min-h-10 max-w-[5.25rem] rounded-lg border px-2 text-xs focus:ring-2 focus:outline-none"
      aria-label={locale === 'es' ? 'Seleccionar tema' : 'Select theme'}
      data-theme-select
    >
      {options.map((opt) => (
        <option value={opt.value}>{opt.label}</option>
      ))}
    </select>
  </label>

  <div class="border-border bg-surface/60 hidden items-center gap-1 rounded-full border p-1 text-xs sm:inline-flex">
    {options.map((opt) => (
      <button
        type="button"
        class="hover:bg-muted focus-visible:outline-primary/70 data-[active=true]:bg-primary data-[active=true]:text-primary-foreground data-[active=true]:border-primary min-h-8 cursor-pointer rounded-full px-2.5 py-1 transition focus-visible:outline focus-visible:outline-2 data-[active=true]:border data-[active=true]:shadow-sm"
        data-theme-option={opt.value}
        aria-pressed="false"
        aria-label={
          locale === 'es'
            ? `Cambiar tema a ${opt.label}`
            : `Switch theme to ${opt.label}`
        }
      >
        {opt.label}
      </button>
    ))}
  </div>
</div>

<script>
  type ThemePreference = 'light' | 'dark' | 'system'

  const THEME_KEY = 'theme'
  const normalizeTheme = (value: string | null): ThemePreference =>
    value === 'light' || value === 'system' ? value : 'dark'

  let preference: ThemePreference = 'dark'
  try {
    preference = normalizeTheme(localStorage.getItem(THEME_KEY))
  } catch {
    // Storage is optional; retain the default preference in memory.
  }

  const applyTheme = (mode: ThemePreference, persist = false) => {
    preference = mode
    const root = document.documentElement
    const systemPrefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)',
    ).matches
    const resolved =
      mode === 'system' ? (systemPrefersDark ? 'dark' : 'light') : mode
    root.classList.toggle('dark', resolved === 'dark')
    root.style.colorScheme = resolved
    if (persist) {
      try {
        localStorage.setItem(THEME_KEY, mode)
      } catch {
        // Controls and system changes continue using the in-memory preference.
      }
    }
    const select = document.querySelector<HTMLSelectElement>(
      'select[data-theme-select]',
    )
    if (select) select.value = mode
    setActive(mode)
  }

  const setActive = (mode: ThemePreference) => {
    document
      .querySelectorAll<HTMLElement>('[data-theme-option]')
      .forEach((btn) => {
        const isActive = btn.dataset.themeOption === mode
        btn.dataset.active = isActive ? 'true' : 'false'
        btn.setAttribute('aria-pressed', String(isActive))
      })
  }

  document.addEventListener('change', (event) => {
    const select = event.target as HTMLSelectElement
    if (
      !select ||
      select.tagName.toLowerCase() !== 'select' ||
      !select.hasAttribute('data-theme-select')
    )
      return
    const mode = normalizeTheme(select.value)
    applyTheme(mode, true)
  })

  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement)?.closest<HTMLElement>(
      '[data-theme-option]',
    )
    if (!btn) return
    const mode = normalizeTheme(btn.getAttribute('data-theme-option'))
    applyTheme(mode, true)
  })

  applyTheme(preference)

  const colorScheme = window.matchMedia('(prefers-color-scheme: dark)')
  const handleSystemChange = () => {
    if (preference === 'system') applyTheme(preference)
  }

  colorScheme.addEventListener('change', handleSystemChange)
</script>
