---
import BasePage from '@/components/layout/BasePage.astro'
import { Image } from 'astro:assets'
import heroImg from '@/assets/me_laptop.avif'
---

<BasePage
  title="404 - Not Found"
  description="404 Error — this page was not found"
>
  <main
    class="flex min-h-screen flex-col items-center justify-center px-8 text-center"
  >
    <Image
      src={heroImg}
      alt="404"
      class="mb-8 h-auto w-52"
      loading="lazy"
      decoding="async"
      format="avif"
      quality={80}
      width={208}
      height={208}
    />
    <p class="text-muted-foreground text-sm">404</p>
    <h1 class="text-4xl font-semibold tracking-tight lg:text-5xl">
      Page not found
    </h1>
    <p class="text-muted-foreground mt-4 mb-6 leading-7">
      Sorry, we couldn't find the page you're looking for.
    </p>
    <a
      href="/"
      rel="noreferrer"
      class="bg-foreground text-background rounded-full px-5 py-2 text-sm font-semibold transition hover:opacity-90"
      >Go back home</a
    >
  </main>
</BasePage>
