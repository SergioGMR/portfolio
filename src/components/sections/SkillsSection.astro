---
import { getAlternatePaths, getLanguage } from '@/lib/site'
import LangText from '@/components/LangText.astro'
import { PROFESSIONAL_PROFILE } from '@/lib/professional-profile'

const capabilities = PROFESSIONAL_PROFILE.capabilities
const locale = getLanguage(Astro.url.pathname)
const caseStudies = PROFESSIONAL_PROFILE.projects.filter(
  (project) => project.kind === 'case-study',
)
const evidenceLinks = new Map([
  ...PROFESSIONAL_PROFILE.experiences.map((experience) => {
    const project = caseStudies.find((project) =>
      project.experienceIds.includes(experience.id),
    )
    return [
      experience.id,
      {
        label:
          project?.title[locale] ??
          (experience.id === 'tecandu'
            ? 'Tecandu'
            : experience.company[locale]),
        href: project
          ? getAlternatePaths(`/proyectos/${project.id}`)[locale]
          : `${locale === 'es' ? '/' : '/en'}#experiencia-${experience.id}`,
      },
    ] as const
  }),
  ...caseStudies.map(
    (project) =>
      [
        project.id,
        {
          label: project.title[locale],
          href: getAlternatePaths(`/proyectos/${project.id}`)[locale],
        },
      ] as const,
  ),
])
---

<section
  id="habilidades"
  class="surface-panel grid gap-6 rounded-3xl p-5 sm:p-7 lg:p-8"
>
  <div data-animate="reveal" class="space-y-3">
    <p class="text-muted-foreground text-xs tracking-[0.3em] uppercase">
      <LangText es="Capacidades" en="Capabilities" />
    </p>
    <h2 class="text-foreground text-2xl font-semibold tracking-tight sm:text-3xl">
      <LangText es="Stack y enfoque" en="Stack and focus" />
    </h2>
    <p class="text-muted-foreground text-sm leading-relaxed">
      <LangText
        es="Capacidades conectadas con mi experiencia y con proyectos concretos."
        en="Capabilities connected to my experience and to specific projects."
      />
    </p>
    <div class="flex flex-wrap gap-1.5 pt-1">
      {[
        ...new Set(capabilities.flatMap(({ technologies }) => technologies)),
      ].map((technology) => (
        <span class="tech-tag rounded-full px-2.5 py-1 text-xs">
          {technology}
        </span>
      ))}
    </div>
  </div>

  <div class="grid min-w-0 gap-3">
    {capabilities.map((capability, index) => (
      <article
        data-animate="reveal-up"
        data-animate-delay={`${index * 70}ms`}
        class="bento-card min-w-0 rounded-2xl p-4"
      >
        <p class="text-primary font-mono text-[10px] tracking-widest uppercase">
          {locale === 'es' && (
            <span data-lang-content="es">{capability.label.es}</span>
          )}
          {locale === 'en' && (
            <span data-lang-content="en">{capability.label.en}</span>
          )}
        </p>
        <p class="text-foreground mt-2 text-sm font-semibold tracking-tight">
          {capability.technologies.join(' · ')}
        </p>
        <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
          {locale === 'es' && (
            <span data-lang-content="es">{capability.summary.es}</span>
          )}
          {locale === 'en' && (
            <span data-lang-content="en">{capability.summary.en}</span>
          )}
        </p>
        <p class="text-muted-foreground border-border mt-3 border-t pt-2.5 font-mono text-[10px]">
          <span data-lang-content={locale}>
            <span class="text-foreground/70 tracking-wider uppercase">
              {locale === 'es' ? 'Evidencia:' : 'Evidence:'}
            </span>{' '}
            {capability.evidenceIds.map((id, index) => {
              const evidence = evidenceLinks.get(id)
              if (!evidence)
                throw new Error(`Missing capability evidence: ${id}`)
              return (
                <>
                  {index > 0 && ' · '}
                  <a
                    href={evidence.href}
                    class="text-primary underline underline-offset-4 hover:no-underline"
                  >
                    {evidence.label}
                  </a>
                </>
              )
            })}
          </span>
        </p>
      </article>
    ))}
  </div>
</section>
