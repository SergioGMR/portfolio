---
import LangText from '@/components/LangText.astro'
import { LINKS } from '@/lib/constants'
import { getLanguage } from '@/lib/site'

const locale = getLanguage(Astro.url.pathname)
const contactOptions = [
  {
    label: { es: 'Proponer un proyecto', en: 'Propose a project' },
    subject: {
      es: 'Proyecto para Sergio Morales',
      en: 'Project for Sergio Morales',
    },
  },
  {
    label: {
      es: 'Hablar de una oportunidad',
      en: 'Discuss a career opportunity',
    },
    subject: {
      es: 'Oportunidad profesional para Sergio Morales',
      en: 'Career opportunity for Sergio Morales',
    },
  },
]
---

<section
  id="contacto"
  class="surface-panel text-foreground grid gap-6 rounded-3xl p-5 sm:p-7 lg:grid-cols-[1.1fr_1fr] lg:p-8"
>
  <div data-animate="reveal" class="space-y-4">
    <p class="text-muted-foreground text-xs tracking-[0.3em] uppercase">
      <LangText es="Sobre mí" en="About" />
    </p>
    <h2 class="text-foreground text-2xl font-semibold sm:text-3xl">
      <LangText
        es="Hablemos de tu equipo o de tu producto."
        en="Let’s talk about your team or your product."
      />
    </h2>
    <p class="text-muted-foreground">
      <LangText
        es="¿Buscas un perfil técnico para tu equipo o apoyo para desarrollar un producto? Cuéntame qué necesitas."
        en="Looking for a technical professional for your team or help developing a product? Tell me what you need."
      />
    </p>
    <div
      data-animate="reveal"
      data-animate-delay="150ms"
      class="bento-card text-muted-foreground rounded-2xl p-4 text-sm"
    >
      <LangText
        es="Ubicado en Las Palmas, España. Experiencia freelance en backend, frontend y aplicaciones web y móviles."
        en="Based in Las Palmas, Spain. Freelance experience across backend, frontend, and web and mobile applications."
      />
    </div>
  </div>
  <div
    data-animate="reveal"
    class="bento-card text-foreground rounded-2xl p-5 sm:p-6"
  >
    <p class="text-muted-foreground text-xs tracking-[0.25em] uppercase">
      <LangText es="Contacto" en="Contact" />
    </p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {contactOptions.map((option) => (
        <a
          href={`${LINKS.mail}?subject=${encodeURIComponent(option.subject[locale])}`}
          class="border-primary/40 bg-primary/10 text-primary hover:bg-primary/20 inline-flex min-h-12 items-center justify-center rounded-xl border px-4 py-3 text-center text-sm font-semibold transition"
        >
          <LangText es={option.label.es} en={option.label.en} />
        </a>
      ))}
    </div>
    <div class="mt-4 space-y-3">
      <div
        data-animate="reveal"
        data-animate-delay="0ms"
        class="border-border bg-muted/30 text-foreground flex min-h-12 flex-col items-start justify-center gap-1 rounded-xl border px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <span class="text-sm">
          <LangText es="Email" en="Email" />
        </span>
        <a class="font-semibold break-all hover:underline" href={LINKS.mail}>
          sergiogmr@icloud.com
        </a>
      </div>
      <div
        data-animate="reveal"
        data-animate-delay="80ms"
        class="border-border bg-muted/30 text-foreground flex min-h-12 items-center justify-between rounded-xl border px-4 py-3"
      >
        <span class="text-sm">LinkedIn</span>
        <a
          class="font-semibold hover:underline"
          href={LINKS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          @sergiogmr
        </a>
      </div>
      <div
        data-animate="reveal"
        data-animate-delay="160ms"
        class="border-border bg-muted/30 text-foreground flex min-h-12 items-center justify-between rounded-xl border px-4 py-3"
      >
        <span class="text-sm">GitHub</span>
        <a
          class="font-semibold hover:underline"
          href={LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          @sergiogmr
        </a>
      </div>
    </div>
  </div>
</section>
