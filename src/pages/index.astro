---
import { Image } from 'astro:assets'

import LangText from '../components/LangText.astro'
import PageShell from '../components/layout/PageShell.astro'
import { EXPERIENCE } from '../lib/constants'
import { PAGE_METADATA } from '../lib/page-metadata'
import basuralezaImg from '../../public/experience/basuraleza.webp'
import solutecImg from '../../public/experience/solutec.webp'
import tcatikImg from '../../public/experience/tcatik.webp'
import todoLuxImg from '../../public/experience/todo-lux.webp'
import heroImg from '../../public/me_laptop.webp'

const experiencesEs = EXPERIENCE.es.slice(0, 4)
const experiencesEn = EXPERIENCE.en.slice(0, 4)

const experienceImages: Record<string, typeof todoLuxImg> = {
  'https://projects.todo-lux.com/': todoLuxImg,
  'https://proyectolibera.org/caracterizacion-residuos/basuraleza':
    basuralezaImg,
  'https://solutec.pccom.ai/': solutecImg,
  'https://tcatik.com/': tcatikImg,
}

const experienceCards = experiencesEs.map((exp, idx) => ({
  es: exp,
  en: experiencesEn[idx],
  image: experienceImages[exp.link] ?? todoLuxImg,
}))

const skillGroups = [
  {
    title: { es: 'Backend', en: 'Backend' },
    items: ['PHP', 'Laravel', 'APIs', 'Livewire', 'Filament'],
  },
  {
    title: { es: 'Frontend', en: 'Frontend' },
    items: ['TypeScript', 'React', 'React Native', 'Vue', 'Tailwind CSS'],
  },
  {
    title: { es: 'Entrega', en: 'Delivery' },
    items: ['Git', 'CI/CD', 'Queues', 'Events', 'Testing'],
  },
]
---

<PageShell localizedMetadata={PAGE_METADATA.home}>
  <section
    aria-labelledby="hero-title"
    class="hero-bg border-border text-foreground grid min-h-[calc(100dvh-5rem)] items-center gap-10 rounded-[2rem] border px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-[1.15fr_0.85fr] lg:px-14"
  >
    <div class="max-w-2xl space-y-6">
      <p class="accent-text animate-fade-in-down text-sm font-semibold">
        <LangText es="Desarrollador Full Stack" en="Full Stack Developer" />
      </p>
      <h1
        id="hero-title"
        class="animate-blurred-fade-in animate-delay-100 text-foreground text-4xl leading-[1.08] font-semibold tracking-[-0.035em] sm:text-5xl lg:text-6xl"
      >
        <LangText
          es="Diseño, construyo y optimizo productos digitales."
          en="I design, build, and optimize digital products."
        />
      </h1>
      <p class="animate-fade-in-up animate-delay-200 text-muted-foreground max-w-xl text-base leading-relaxed sm:text-lg">
        <LangText
          es="Backend first con PHP/Laravel, APIs y un toque de front con TypeScript/React. Orientado a entregar rápido y con calidad."
          en="Backend-first with PHP/Laravel, APIs, and a front touch with TypeScript/React. Focused on shipping fast with quality."
        />
      </p>
      <div class="animate-fade-in animate-delay-300 flex flex-wrap items-center gap-3">
        <a
          href="mailto:sergiogmr+portfolio@icloud.com"
          class="primary-action rounded-full px-5 py-2.5 text-sm font-semibold transition hover:brightness-110 active:translate-y-px"
        >
          <LangText es="Contacto" en="Contact" />
        </a>
        <a
          data-lang-content="es"
          href="/sergio-morales-2024-es.pdf"
          class="border-border bg-background/70 text-foreground hover:border-primary rounded-full border px-5 py-2.5 text-sm font-semibold transition"
          target="_blank"
        >
          Ver CV
        </a>
        <a
          data-lang-content="en"
          href="/sergio-morales-2024-en.pdf"
          class="border-border bg-background/70 text-foreground hover:border-primary rounded-full border px-5 py-2.5 text-sm font-semibold transition"
          target="_blank"
        >
          View CV
        </a>
      </div>
    </div>

    <div class="animate-fade-in animate-delay-150 md:animate-slide-in-right mx-auto w-full max-w-md">
      <Image
        src={heroImg}
        alt="Sergio working on laptop"
        class="border-border aspect-square w-full rounded-[1.5rem] border object-cover shadow-[0_24px_70px_-36px_hsl(var(--foreground)/0.4)]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={900}
        height={900}
        sizes="(min-width: 1024px) 38vw, (min-width: 640px) 28rem, calc(100vw - 5rem)"
      />
    </div>
  </section>

  <section id="experience" aria-labelledby="experience-title" class="py-4">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <h2
        id="experience-title"
        class="text-foreground text-3xl font-semibold tracking-[-0.025em] sm:text-4xl"
      >
        <LangText es="Experiencia seleccionada" en="Selected experience" />
      </h2>
      <a
        href="https://www.linkedin.com/in/sergiogmr"
        class="accent-text w-fit text-sm font-semibold underline-offset-4 hover:underline"
      >
        LinkedIn
      </a>
    </div>

    <div class="border-border mt-8 border-t">
      {EXPERIENCE.es.slice(0, 4).map((exp) => (
        <article
          data-lang-content="es"
          data-animate="animate-fade-in-up"
          class="border-border grid gap-3 border-b py-6 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8"
        >
          <p class="text-muted-foreground font-mono text-sm">
            {exp.start} - {exp.end}
          </p>
          <div>
            <h3 class="text-foreground text-xl font-semibold">
              {exp.position}
            </h3>
            <a
              class="accent-text mt-1 inline-block text-sm underline-offset-4 hover:underline"
              href={exp.link}
            >
              {exp.company}
            </a>
            <ul class="text-muted-foreground mt-3 grid gap-1 text-sm leading-relaxed sm:grid-cols-2 sm:gap-x-8">
              {exp.tasks.slice(0, 2).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
      {EXPERIENCE.en.slice(0, 4).map((exp) => (
        <article
          data-lang-content="en"
          data-animate="animate-fade-in-up"
          class="border-border grid gap-3 border-b py-6 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8"
        >
          <p class="text-muted-foreground font-mono text-sm">
            {exp.start} - {exp.end}
          </p>
          <div>
            <h3 class="text-foreground text-xl font-semibold">
              {exp.position}
            </h3>
            <a
              class="accent-text mt-1 inline-block text-sm underline-offset-4 hover:underline"
              href={exp.link}
            >
              {exp.company}
            </a>
            <ul class="text-muted-foreground mt-3 grid gap-1 text-sm leading-relaxed sm:grid-cols-2 sm:gap-x-8">
              {exp.tasks.slice(0, 2).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section
    id="skills"
    aria-labelledby="skills-title"
    class="border-border border-y py-12 sm:py-16"
  >
    <div class="max-w-2xl">
      <h2
        id="skills-title"
        class="text-foreground text-3xl font-semibold tracking-[-0.025em] sm:text-4xl"
      >
        <LangText es="Stack y enfoque" en="Stack and focus" />
      </h2>
      <p class="text-muted-foreground mt-3 leading-relaxed">
        <LangText
          es="Foco en backend escalable y APIs limpias. Priorizo flujos claros de entrega y comunicación con negocio."
          en="Focus on scalable backend and clean APIs. I prioritize clear delivery flows and business alignment."
        />
      </p>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-0">
      {skillGroups.map((group, idx) => (
        <section
          data-skill-group
          data-animate="animate-fade-in-up"
          data-animate-delay={`${idx * 100}ms`}
          class="border-border md:border-l md:px-8 md:first:border-l-0 md:first:pl-0"
        >
          <h3 class="text-foreground text-lg font-semibold">
            <span data-lang-content="es">{group.title.es}</span>
            <span data-lang-content="en">{group.title.en}</span>
          </h3>
          <ul class="text-muted-foreground mt-4 space-y-2 text-sm">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <h2
      id="projects-title"
      class="text-foreground text-3xl font-semibold tracking-[-0.025em] sm:text-4xl"
    >
      <LangText es="Trabajo reciente" en="Recent work" />
    </h2>

    <div class="mt-8 grid gap-x-8 gap-y-12 md:grid-cols-12">
      {experienceCards.map((card, idx) => (
        <a
          href={card.es.link}
          target="_blank"
          rel="noreferrer noopener"
          data-animate="animate-slide-up-fade"
          data-animate-delay={`${idx * 100}ms`}
          data-project-priority={idx === 0 ? 'lead' : 'supporting'}
          class:list={[
            'group block min-w-0',
            idx === 0 ? 'md:col-span-7 md:row-span-2' : 'md:col-span-5',
          ]}
        >
          <div class="border-border bg-muted overflow-hidden rounded-[1.25rem] border">
            <Image
              src={card.image}
              alt={card.es.company}
              class:list={[
                'w-full object-cover transition duration-300 group-hover:scale-[1.02]',
                idx === 0 ? 'h-64 sm:h-80 md:h-full md:min-h-[31rem]' : 'h-52',
              ]}
              loading="lazy"
              decoding="async"
              widths={[260, 352, 525, 700, 900]}
              width={900}
              height={480}
              sizes={
                idx === 0
                  ? '(min-width: 768px) 58vw, calc(100vw - 2rem)'
                  : '(min-width: 768px) 42vw, calc(100vw - 2rem)'
              }
            />
          </div>
          <div data-lang-content="es" class="mt-4">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-foreground text-xl font-semibold">
                {card.es.company}
              </h3>
              <span aria-hidden="true" class="accent-text text-lg">
                ↗
              </span>
            </div>
            <p class="text-foreground/90 mt-1 text-sm font-semibold">
              {card.es.position}
            </p>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              {card.es.tasks.slice(0, 2).join(' · ')}
            </p>
          </div>
          <div data-lang-content="en" class="mt-4">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-foreground text-xl font-semibold">
                {card.en?.company}
              </h3>
              <span aria-hidden="true" class="accent-text text-lg">
                ↗
              </span>
            </div>
            <p class="text-foreground/90 mt-1 text-sm font-semibold">
              {card.en?.position}
            </p>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              {card.en?.tasks?.slice(0, 2).join(' · ')}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section
    id="contact"
    aria-labelledby="about-title"
    class="border-border grid gap-10 border-t pt-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16"
  >
    <div data-animate="animate-fade-in-left" class="max-w-2xl">
      <h2
        id="about-title"
        class="text-foreground text-3xl font-semibold tracking-[-0.025em] sm:text-4xl"
      >
        <LangText
          es="Colaboro de forma cercana y pragmática."
          en="I collaborate closely and pragmatically."
        />
      </h2>
      <p class="text-muted-foreground mt-4 leading-relaxed">
        <LangText
          es="Me gusta entrar en proyectos con contexto, mapear riesgos, definir métricas y entregar rápido. Hablo con negocio y con ingeniería."
          en="I like to enter projects with context, map risks, define metrics, and ship fast. I talk with business and engineering."
        />
      </p>
      <p class="text-muted-foreground mt-4 text-sm">
        <LangText
          es="Ubicado en Islas Canarias (UTC+0/+1). Trabajo remoto y asincrónico con equipos distribuidos."
          en="Based in Canary Islands (UTC+0/+1). Remote and async with distributed teams."
        />
      </p>
    </div>

    <div data-animate="animate-fade-in-right">
      <h2 class="text-foreground text-2xl font-semibold">
        <LangText es="Contacto" en="Contact" />
      </h2>
      <div class="border-border mt-5 border-t">
        <a
          class="accent-hover border-border text-foreground flex items-center justify-between gap-4 border-b py-4 font-semibold transition"
          href="mailto:sergiogmr+portfolio@icloud.com"
        >
          Email
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="accent-hover border-border text-foreground flex items-center justify-between gap-4 border-b py-4 font-semibold transition"
          href="https://www.linkedin.com/in/sergiogmr"
          target="_blank"
          rel="noreferrer noopener"
        >
          LinkedIn
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="accent-hover border-border text-foreground flex items-center justify-between gap-4 border-b py-4 font-semibold transition"
          href="https://github.com/sergiogmr"
          target="_blank"
          rel="noreferrer noopener"
        >
          GitHub
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</PageShell>
