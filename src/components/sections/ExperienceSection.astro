---
import { getLanguage } from '@/lib/site'
import LangText from '@/components/LangText.astro'
import {
  PROFESSIONAL_PROFILE,
  sortExperiencesByStartDate,
  type ExperienceStatus,
  type Locale,
} from '@/lib/professional-profile'

const experiences = sortExperiencesByStartDate(PROFESSIONAL_PROFILE.experiences)

const statusLabels: Record<Locale, Record<ExperienceStatus, string>> = {
  es: { current: 'Actual', completed: 'Finalizado' },
  en: { current: 'Current', completed: 'Completed' },
}

const employmentLabels = {
  es: { freelance: 'Freelance' },
  en: { freelance: 'Freelance' },
} as const

const formatDate = (date: string, locale: Locale) =>
  new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${date}T00:00:00Z`))

const dateRange = (experience: (typeof experiences)[number], locale: Locale) =>
  `${formatDate(experience.startDate, locale)} — ${experience.endDate ? formatDate(experience.endDate, locale) : locale === 'es' ? 'Actualidad' : 'Current'}`
const locale = getLanguage(Astro.url.pathname)
---

<section id="experiencia" class="min-w-0">
  <div
    data-animate="reveal"
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 pb-4 sm:pb-6"
  >
    <h2 class="font-display text-foreground flex items-baseline gap-3 text-[2.125rem] leading-none font-bold tracking-[-0.04em] sm:gap-[1.125rem] sm:text-[clamp(2.25rem,4vw,3.5rem)]">
      <span
        data-section-number
        class="text-primary font-mono text-[0.8125rem] font-normal tracking-normal sm:text-sm"
        aria-hidden="true"
      >
        02
      </span>
      <LangText es="Experiencia" en="Experience" />
    </h2>
    <a
      href={PROFESSIONAL_PROFILE.links.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="text-primary inline-flex min-h-11 items-center font-mono text-xs underline underline-offset-4 hover:no-underline sm:text-[0.8125rem]"
    >
      LinkedIn ↗
    </a>
  </div>

  <ol role="list" class="border-foreground min-w-0 border-y">
    {experiences.map((experience, index) => (
      <li
        data-animate="reveal-up"
        data-animate-delay={`${index * 70}ms`}
        class="border-border not-first:border-t"
      >
        <article
          id={`experiencia-${experience.id}`}
          data-experience-row
          class="grid min-w-0 gap-x-8 gap-y-4 py-5 sm:py-7 lg:grid-cols-[11rem_minmax(0,1fr)_minmax(0,1.6fr)]"
        >
          <div class="text-muted-foreground font-mono text-xs">
            <p data-experience-period>
              <span data-lang-content={locale}>
                {dateRange(experience, locale)}
              </span>
            </p>
            <p class="mt-1">
              <span data-lang-content={locale}>
                {statusLabels[locale][experience.status]} ·{' '}
                {employmentLabels[locale][experience.employmentType]}
              </span>
            </p>
          </div>

          <div class="min-w-0">
            <h3 class="font-display text-foreground text-2xl leading-[1.1] font-semibold tracking-[-0.03em] sm:text-[1.75rem]">
              <span data-lang-content={locale}>{experience.title[locale]}</span>
            </h3>
            <p
              data-experience-company
              class="text-muted-foreground mt-2 text-base"
            >
              {experience.evidenceUrl ? (
                <a
                  href={experience.evidenceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary inline-flex min-h-11 items-center underline underline-offset-4 hover:no-underline"
                >
                  <span data-lang-content={locale}>
                    {experience.company[locale]} · {experience.location[locale]}{' '}
                    ↗
                  </span>
                </a>
              ) : (
                <span data-lang-content={locale}>
                  {experience.company[locale]} · {experience.location[locale]}
                </span>
              )}
            </p>
          </div>

          <div class="min-w-0">
            <ul class="text-foreground/85 list-disc space-y-1.5 pl-4 text-[0.9375rem] leading-[1.45] sm:text-base sm:leading-normal">
              {experience.responsibilities[locale].slice(0, 3).map((item) => (
                <li data-lang-content={locale}>{item}</li>
              ))}
            </ul>
            <p
              data-experience-outcome
              class="border-border mt-4 border-t pt-3 text-[0.9375rem] leading-[1.45]"
            >
              <strong class="text-success font-semibold">
                <LangText es="Resultado:" en="Outcome:" />
              </strong>{' '}
              <span data-lang-content={locale}>
                {experience.outcomes[locale][0]}
              </span>
            </p>
            <p
              data-experience-tech
              class="text-muted-foreground mt-3 font-mono text-xs sm:text-[0.8125rem]"
            >
              {experience.technologies.join(' · ')}
            </p>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>
