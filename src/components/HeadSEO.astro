---
import type {
  Language,
  LanguageMetadata,
  LanguageMetadataEntry,
} from '../lib/language-client'
import {
  serializeJsonForScript,
  serializeLanguageMetadata,
} from '../lib/language-client'

interface Props {
  title?: string
  description?: string
  localizedMetadata?: LanguageMetadata
  ogImage?: URL | string
  noindex?: boolean
  nofollow?: boolean
  locale?: Language
  canonicalOverride?: URL | string
  schema?: Record<string, unknown>
  ogType?: string
}

const site = Astro.site?.toString() ?? ''
const canonicalURL = new URL(
  Astro.props.canonicalOverride ?? Astro.url.pathname,
  site,
)
const resolvedOgImage =
  Astro.props.ogImage === undefined
    ? new URL('/og.webp', site)
    : typeof Astro.props.ogImage === 'string'
      ? new URL(Astro.props.ogImage, site)
      : Astro.props.ogImage

const {
  title = '',
  description = '',
  localizedMetadata,
  noindex = false,
  nofollow = false,
  locale = 'es',
  schema,
  ogType = 'website',
} = Astro.props

const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
].join(', ')

const keywords = [
  'Sergio Morales Rodríguez',
  'desarrollador fullstack',
  'fullstack developer',
  'backend developer',
  'frontend developer',
  'PHP',
  'Laravel',
  'JavaScript',
  'TypeScript',
  'React',
  'React Native',
  'Vue',
  'Git',
  'CSS',
  'Tailwind CSS',
  'Bootstrap',
  'Livewire',
  'Filamentphp',
  'QuasarFramework',
  'DevOps',
  'CI-CD',
  'Github Actions',
  'Plesk',
  'desarrollo web',
  'web development',
  'portfolio',
  'freelance developer',
  'Islas Canarias',
  'Canary Islands',
  'Spain',
  'España',
  'desarrollador web',
].join(', ')

const fallbackEntry: LanguageMetadataEntry = {
  title,
  description,
  imageAlt: `Image for ${title}`,
  schema,
}
const sourceMetadata =
  localizedMetadata ??
  ({ es: fallbackEntry, en: fallbackEntry } satisfies LanguageMetadata)

const defaultSchema = (entry: LanguageMetadataEntry, language: Language) => ({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sergio Morales Rodríguez - Portfolio',
  url: site,
  description: entry.description,
  inLanguage: language,
  author: {
    '@type': 'Person',
    name: 'Sergio Morales Rodríguez',
    url: canonicalURL.toString(),
    jobTitle:
      language === 'es' ? 'Desarrollador Full Stack' : 'Full Stack Developer',
    sameAs: [
      'https://github.com/SergioGMR',
      'https://www.linkedin.com/in/sergiogmr',
    ],
  },
  keywords: keywords.split(', '),
})

const resolveEntry = (
  entry: LanguageMetadataEntry,
  language: Language,
): LanguageMetadataEntry => ({
  ...entry,
  schema: entry.schema ?? defaultSchema(entry, language),
})
const metadata: LanguageMetadata = {
  es: resolveEntry(sourceMetadata.es, 'es'),
  en: resolveEntry(sourceMetadata.en, 'en'),
}
const initial = metadata[locale]
const initialOgLocale = locale === 'es' ? 'es_ES' : 'en_US'
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{initial.title}</title>
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<link rel="canonical" href={canonicalURL} />
<meta name="description" content={initial.description} />
<meta name="author" content="Sergio Morales Rodríguez" />
<meta name="keywords" content={keywords} />
<meta property="og:locale" content={initialOgLocale} />

<link rel="icon" type="image/webp" href="/favicon.webp" />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={initial.title} />
<meta property="og:description" content={initial.description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:secure_url" content={resolvedOgImage} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:alt" content={initial.imageAlt} />
<meta property="og:site_name" content="Sergio Morales Rodríguez - Portfolio" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={initial.title} />
<meta property="twitter:description" content={initial.description} />
<meta property="twitter:image" content={resolvedOgImage} />
<meta property="twitter:image:alt" content={initial.imageAlt} />
<meta name="twitter:site" content="@sergiogmr" />
<meta name="twitter:creator" content="@sergiogmr" />

<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content="#ffffff"
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content="#111111"
/>
<meta name="color-scheme" content="light dark" />

<script
  type="application/json"
  data-language-metadata
  set:html={serializeLanguageMetadata(metadata)}
/>
<script
  type="application/ld+json"
  data-language-schema
  set:html={serializeJsonForScript(initial.schema)}
/>
